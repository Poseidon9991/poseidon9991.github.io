      </section>

      <!-- ═══════════ TOOLKIT ═══════════ -->
      <section class="win" id="stack" aria-label="Stack">
        <div class="wbar">
          <span class="wtitle">■ C:\dev\toolkit — command</span>
          <span class="wbtns"><i>_</i><i>□</i><i>✕</i></span>
        </div>
        <div class="wpad">
          <table class="tbl">
            <tbody>
