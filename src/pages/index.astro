import '@fontsource/spline-sans-mono/400.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Hoeng Reaksa — Full-Stack Developer</title>
  <meta name="description" content="Hoeng Reaksa, full-stack developer in Phnom Penh, Cambodia. Offline-first SFA apps, Laravel APIs, React frontends, end to end." />
  <meta name="theme-color" content="#F3F5EF" />
  <meta property="og:title" content="Hoeng Reaksa — Full-Stack Developer" />
  <meta property="og:description" content="Offline-first SFA apps and the Laravel APIs that power them, from UI to database." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="topbar">
    <a class="mark" href="#top" aria-label="Hoeng Reaksa, back to top">
      <svg width="22" height="22" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" fill="none" stroke="currentColor" stroke-opacity=".25"/>
        <path d="M8 0v32M16 0v32M24 0v32M0 8h32M0 16h32M0 24h32" stroke="currentColor" stroke-opacity=".12"/>
        <path d="M7 22V10h5a3 3 0 0 1 0 6H7m5 0 4 6" fill="none" stroke="#146B45" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
