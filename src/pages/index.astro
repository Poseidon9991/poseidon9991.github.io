          </figure>

          <pre class="ini">[system]
user      = Hoeng Reaksa
location  = Phnom Penh, Cambodia
employer  = DaunPenh Data Center (Software Developer)
focus     = offline-first PWA + clean APIs
version   = 2026.09</pre>

          <div class="crtwrap">
            <div class="crtbar"><span>sync_demo.exe</span><span>■</span></div>
            <canvas class="solid crt" width="300" height="200" role="img" aria-label="Wireframe phone syncing data packets to a server rack — drag to rotate"></canvas>
            <p class="crtcap">Fig. 02 — offline queue → API, live render. Drag to rotate.</p>
          </div>

          <div class="btnrow">
            <a class="btn95" href="mailto:hongraksa097@gmail.com">📧 Email me</a>
            <a class="btn95" href="https://t.me/ReaksaNamikaze" rel="me noopener">Telegram</a>
          </div>
        </div>
      </section>

      <!-- ═══════════ ABOUT.TXT ═══════════ -->
      <section class="win" id="about" aria-label="About">
        <div class="wbar">
          <span class="wtitle">■ about.txt — Notepad</span>
          <span class="wbtns"><i>_</i><i>□</i><i>✕</i></span>
        </div>
        <div class="wpad">
          <p>
            I'm a full-stack developer in Phnom Penh shipping production systems for
            Cambodia's distribution industry: a sales-force app that reps use on the road
            without signal, and the Laravel platform that approves, syncs, and reports
            those orders.
          </p>
