        'taczxfracturepointbackpack': '[TaCZ] Fracture Point\'s BackPack Compatibility Addon — reload & ammo-box support from WARBORN packs.',
        'zombie_custom_drop': 'Configurable Zombie Drops — custom extra item drops, drop chances, and stack sizes for zombie mobs.',
        'flashgame_retro_emulator_game': 'Reaksa Arcade — bilingual English/Khmer retro Flash-game portal running real .swf cartridges via Ruffle.',
        'poseidon9991.github.io': 'This portfolio. Astro, manga style.'
      };
      const FALLBACK_REPOS = [
        { name: 'Simple-Enemy-Mod-ClassSystem', language: 'Java', stargazers_count: 0, forks_count: 0, html_url: 'https://github.com/Poseidon9991/Simple-Enemy-Mod-ClassSystem', updated_at: '2026-11-09', description: REPO_FALLBACK_DESCS['Simple-Enemy-Mod-ClassSystem'] },
        { name: 'poseidon-lib', language: 'Java', stargazers_count: 0, forks_count: 0, html_url: 'https://github.com/Poseidon9991/poseidon-lib', updated_at: '2026-10-18', description: REPO_FALLBACK_DESCS['poseidon-lib'] },
        { name: 'taczxtravelerbackpack', language: 'Java', stargazers_count: 0, forks_count: 0, html_url: 'https://github.com/Poseidon9991/taczxtravelerbackpack', updated_at: '2026-11-09', description: REPO_FALLBACK_DESCS['taczxtravelerbackpack'] },
        { name: 'taczxfracturepointbackpack', language: 'Java', stargazers_count: 0, forks_count: 0, html_url: 'https://github.com/Poseidon9991/taczxfracturepointbackpack', updated_at: '2026-11-09', description: REPO_FALLBACK_DESCS['taczxfracturepointbackpack'] },
        { name: 'zombie_custom_drop', language: 'Java', stargazers_count: 0, forks_count: 0, html_url: 'https://github.com/Poseidon9991/zombie_custom_drop', updated_at: '2026-10-18', description: REPO_FALLBACK_DESCS['zombie_custom_drop'] },
        { name: 'flashgame_retro_emulator_game', language: 'JavaScript', stargazers_count: 0, forks_count: 0, html_url: 'https://github.com/Poseidon9991/flashgame_retro_emulator_game', updated_at: '2026-10-05', description: REPO_FALLBACK_DESCS['flashgame_retro_emulator_game'] },
        { name: 'poseidon9991.github.io', language: 'Astro', stargazers_count: 0, forks_count: 0, html_url: 'https://github.com/Poseidon9991/poseidon9991.github.io', updated_at: '2026-10-06', description: REPO_FALLBACK_DESCS['poseidon9991.github.io'] }
      ];

      const reposEl = document.getElementById('ghRepos');
      const filterWrap = document.getElementById('repoFilters');
      const searchIn = document.getElementById('repoSearch');
      let currentRepos = FALLBACK_REPOS.slice();
      let activeFilter = 'all';
      let searchTerm = '';

      const esc = s => String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      const renderRepos = () => {
        if (!reposEl) return;
        const q = searchTerm.trim().toLowerCase();
        const list = currentRepos.filter(r => {
          if (activeFilter === 'Java' && r.language !== 'Java') return false;
          if (activeFilter === 'web' && r.language === 'Java') return false;
          if (!q) return true;
          const desc = (r.description || REPO_FALLBACK_DESCS[r.name] || '').toLowerCase();
          return r.name.toLowerCase().includes(q) || desc.includes(q) || (r.language || '').toLowerCase().includes(q);
        });
        if (!list.length) {
          reposEl.innerHTML = '<div class="repo-empty">No matching public repositories found.</div>';
          return;
        }
        reposEl.innerHTML = list.map(r => {
          const desc = r.description || REPO_FALLBACK_DESCS[r.name] || 'Public repository by Poseidon9991.';
          const lang = r.language || 'Code';
          const upd = (r.updated_at || '').slice(0, 10);
          const starSvg = '<svg class="ico-svg" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2Z"/></svg>';
          const forkSvg = '<svg class="ico-svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/></svg>';
          return (
            '<a class="repo-card" href="' + esc(r.html_url) + '" target="_blank" rel="noopener">' +
              '<div class="repo-head"><span class="repo-name">' + esc(r.name) + '</span><span class="repo-lang">' + esc(lang) + '</span></div>' +
              '<p class="repo-desc">' + esc(desc) + '</p>' +
              '<div class="repo-foot"><span class="repo-meta">' + starSvg + ' ' + (r.stargazers_count || 0) + ' · ' + forkSvg + ' ' + (r.forks_count || 0) + (upd ? ' · ' + esc(upd) : '') + '</span><span class="repo-go">OPEN →</span></div>' +
            '</a>'
          );
        }).join('');
      };
      renderRepos();

      if (filterWrap) {
        filterWrap.addEventListener('click', e => {
          const btn = e.target.closest('.filter-btn');
          if (!btn) return;
          activeFilter = btn.getAttribute('data-filter') || 'all';
          filterWrap.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b === btn));
          renderRepos();
        });
      }
      if (searchIn) {
        searchIn.addEventListener('input', () => { searchTerm = searchIn.value; renderRepos(); });
      }

      /* Live GitHub API Hydration */
      const heatReadout = document.getElementById('heatReadout');
      (async () => {
        const GH = 'Poseidon9991';
        const tiles = document.getElementById('ghTiles');
        const langsEl = document.getElementById('ghLangs');
        const heatEl = document.getElementById('ghHeat');
        const foot = document.getElementById('ghFoot');
        if (!tiles && !langsEl && !heatEl) return;
        const fail = () => {
          if (foot) foot.innerHTML = '<a href="https://github.com/' + GH + '?tab=repositories" target="_blank" rel="me noopener" data-pop="GITHUB!">▶ VIEW ALL REPOS — github.com/' + GH + '</a>';
        };
        try {
          const [uRes, rRes] = await Promise.all([
            fetch('https://api.github.com/users/' + GH),
            fetch('https://api.github.com/users/' + GH + '/repos?per_page=100&sort=updated')
          ]);
          if (!uRes.ok || !rRes.ok) return fail();
          const user = await uRes.json();
          const repos = await rRes.json();

          if (Array.isArray(repos)) {
            const own = repos.filter(r => !r.fork && r.name !== GH);
            if (own.length) { currentRepos = own; renderRepos(); }
          }
          if (tiles) {
            const stars = repos.reduce((s, r) => s + (r.stargazers_count || 0), 0);
            const vals = [user.public_repos, stars, user.followers];
            [...tiles.querySelectorAll('.gh-tile')].forEach((tile, i) => {
              const b = tile.querySelector('b');
              if (b && vals[i] != null) b.textContent = String(vals[i]);
            });
          }
          const badgeRepos = document.getElementById('ghBadgeRepos');
          const badgeFollowers = document.getElementById('ghBadgeFollowers');
          if (badgeRepos && user.public_repos != null) badgeRepos.textContent = user.public_repos + ' PUBLIC';
          if (badgeFollowers && user.followers != null) badgeFollowers.textContent = String(user.followers);
          if (langsEl) {
            const langs = {};
            repos.forEach(r => { if (r.fork || !r.language) return; langs[r.language] = (langs[r.language] || 0) + (r.size || 0); });
            const top = Object.entries(langs).sort((a, b) => b[1] - a[1]).slice(0, 5);
            const max = top.length ? top[0][1] : 1;
            const total = top.reduce((s, l) => s + l[1], 0) || 1;
            langsEl.innerHTML = top.map(([name, size]) =>
              '<div class="lrow"><span class="lname">' + esc(name) + '</span>' +
              '<span class="ltrack"><i class="lbar" style="width:' + Math.round(size / max * 100) + '%"></i></span>' +
              '<b class="lpct">' + Math.round(size / total * 100) + '%</b></div>'
            ).join('');
          }
          if (heatEl) {
            const counts = {};
            for (let p = 1; p <= 3; p++) {
              const res = await fetch('https://api.github.com/users/' + GH + '/events/public?per_page=100&page=' + p);
              if (!res.ok) break;
              const evs = await res.json();
              if (!Array.isArray(evs) || !evs.length) break;
              evs.forEach(e => { const d = (e.created_at || '').slice(0, 10); if (d) counts[d] = (counts[d] || 0) + 1; });
            }
            const today = new Date();
            let total = 0;
            for (let i = 90; i >= 0; i--) {
              const d = new Date(today);
              d.setDate(d.getDate() - i);
              const key = d.toISOString().slice(0, 10);
              const c = counts[key] || 0;
              total += c;
              const cell = document.createElement('i');
              cell.dataset.l = c === 0 ? 0 : c === 1 ? 1 : c <= 3 ? 2 : c <= 6 ? 3 : 4;
              const label = c + (c === 1 ? ' event' : ' events') + ' · ' + key;
              cell.title = label;
              cell.addEventListener('mouseenter', () => { if (heatReadout) heatReadout.textContent = label; });
              heatEl.appendChild(cell);
            }
            heatEl.setAttribute('aria-label', 'GitHub public activity, last 90 days — ' + total + ' events');
          }
        } catch (e) { fail(); }
      })();

      /* ── Manga Volume Cover Entry ── */
      const cover = document.getElementById('cover');
      const coverCard = document.getElementById('coverCard');
      let opened = false, experienceStarted = false;
      const startExperience = () => {
        if (experienceStarted) return;
        experienceStarted = true;
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
        shellBootStart();
      };
      if (cover) {
        document.body.classList.add('covering');
        if (finePointer && !reduced && coverCard) {
          cover.addEventListener('pointermove', e => {
            if (e.pointerType !== 'mouse') return;
            const dx = (e.clientX / window.innerWidth - 0.5) * 10;
            const dy = (e.clientY / window.innerHeight - 0.5) * 10;
            coverCard.style.transform = `perspective(900px) rotateY(${dx.toFixed(1)}deg) rotateX(${(-dy).toFixed(1)}deg)`;
          }, { passive: true });
        }
        const openManga = () => {
          if (opened) return;
          opened = true;
          triggerSlash('CHAPTER 01!!');
          document.body.classList.remove('covering');
          cover.classList.add('done');
          setTimeout(() => cover.remove(), 500);
          startExperience();
        };
        cover.addEventListener('click', openManga);
        document.addEventListener('keydown', e => {
          if (opened) return;
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openManga(); }
        });
      } else {
        startExperience();
      }
    })();
  </script>
</body>
</html>
