            <div>
              <h4>Provida Analytics</h4>
              <p>Internal analytics dashboard over the Provida sales dataset: orders, wholesale, customer visits, vehicles and staff.</p>
              <span class="lmeta">Laravel 12 · Inertia.js · Vue 3</span>
            </div>
          </li>
        </ol>
      </div>
    </section>

