---
import '@fontsource/dela-gothic-one/400.css';
import '@fontsource/bangers/400.css';
import '@fontsource/permanent-marker/400.css';
import '@fontsource/anton/400.css';
import '@fontsource/comic-neue/400.css';
import '@fontsource/comic-neue/700.css';
import '@fontsource/comic-neue/700-italic.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/zen-kaku-gothic-new/900.css';
import '@fontsource/spline-sans-mono/600.css';
import '@fontsource/spline-sans-mono/700.css';
import '@fontsource/kantumruy-pro/600.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>HOENG REAKSA — VOL.01 // FULL-STACK MANGA PORTFOLIO</title>
  <meta name="description" content="Hoeng Reaksa, full-stack developer in Phnom Penh, Cambodia. Offline-first SFA apps, Laravel APIs, React frontends, open-source GitHub repos & CurseForge mods." />
  <meta name="theme-color" content="#F5F0E4" />
  <meta property="og:title" content="Hoeng Reaksa — Full-Stack Developer" />
  <meta property="og:description" content="Offline-first SFA apps, Laravel APIs, public GitHub repos, and CurseForge mods." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    document.documentElement.classList.add('js');
    try {
      var t = localStorage.getItem('hr_theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    } catch (e) {}
  </script>
</head>
<body>
  <!-- ═══════════ ANIME RUNNING DUST, DIRT DEBRIS & PEN SFX CANVAS ═══════════ -->
  <canvas id="fxCanvas" aria-hidden="true"></canvas>

  <!-- ═══════════ COMPACT MANGAKA G-PEN NIB (22×22px) ═══════════ -->
  <div class="manga-cursor" id="mCursor" aria-hidden="true">
    <svg class="gpen-svg" viewBox="0 0 26 26" width="22" height="22" fill="none">
      <!-- Ink spark at nib tip on interactive hover -->
      <circle class="gpen-drop" cx="2.2" cy="2.2" r="2.1" fill="var(--yellow)" stroke="#111116" stroke-width="1.3"/>
      <!-- Short compact crimson grip stub -->
      <path d="M13.5 11 L23.5 20.5 C24.4 21.4 24.3 22.8 23.3 23.6 C22.4 24.3 21 24.2 20 23.2 L10.8 13.8 Z" fill="#E6002E" stroke="#111116" stroke-width="2" stroke-linejoin="round"/>
      <!-- Gold ferrule collar -->
      <path d="M9.8 12.6 L12.6 9.8 L15.4 12.6 L12.6 15.4 Z" fill="#FFD400" stroke="#111116" stroke-width="1.8" stroke-linejoin="miter"/>
      <!-- Compact Steel G-Pen Nib -->
      <path d="M1.6 1.6 L11.2 4.4 L13.2 9.8 L9.8 13.2 L4.4 11.2 Z" fill="#FCFBF7" stroke="#111116" stroke-width="2" stroke-linejoin="miter"/>
      <!-- G-Pen Slit + Breather Hole -->
      <path d="M2 2 L7.8 7.8" stroke="#111116" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="8.2" cy="8.2" r="1.4" fill="#111116"/>
    </svg>
    <span class="gpen-sfx" id="gpenSfx">カリッ!</span>
  </div>

  <!-- ═══════════ MANGA WORLD 3D BACKDROP ═══════════ -->
  <div class="manga-bg" aria-hidden="true"></div>
  <div class="manga-stage-3d" id="mangaStage3d" aria-hidden="true">
    <div class="stage-grid-3d"></div>
    <div class="bg-panel-3d bp-1"><span>CH.01</span></div>
    <div class="bg-panel-3d bp-2"><span>VOL.01</span></div>
    <div class="bg-panel-3d bp-3"><span>INK//3D</span></div>
  </div>

  <!-- Parallax vertical katakana margin SFX -->
  <div class="manga-margin-sfx" id="marginSfx" aria-hidden="true">
    <span class="msfx msfx-1" data-speed="0.08">ドドド</span>
    <span class="msfx msfx-2" data-speed="-0.06">ゴゴゴ</span>
    <span class="msfx msfx-3" data-speed="0.05">シャキーン</span>
    <span class="msfx msfx-4" data-speed="-0.09">バチッ!!</span>
  </div>

  <!-- Falling ink speed streaks -->
  <div class="streak-layer" aria-hidden="true">
    <span class="streak s1"></span><span class="streak s2"></span>
    <span class="streak s3"></span><span class="streak s4"></span>
    <span class="streak s5"></span><span class="streak s6"></span>
    <span class="streak s7"></span><span class="streak s8"></span>
    <span class="streak s9"></span><span class="streak s10"></span>
  </div>

  <!-- Diagonal anime slash transition overlay -->
  <div class="slash-wipe" id="slashWipe" aria-hidden="true">
    <div class="slash-blade"></div>
    <span class="slash-word" id="slashWord">SLASH!!</span>
  </div>

  <!-- ═══════════ MANGA VOLUME COVER (ENTRY) ═══════════ -->
  <div class="cover" id="cover" role="button" tabindex="0" aria-label="Open manga portfolio">
    <div class="cover-speedlines" aria-hidden="true"></div>
    <div class="cover-card" id="coverCard">
      <div class="cover-obi" aria-hidden="true">
        <span>週刊フルスタック</span>
        <span>第01巻</span>
        <span>2026</span>
      </div>
      <div class="cover-body">
        <div class="cover-top-strip">
          <span class="issue-badge">VOL. 01 // SPECIAL ISSUE</span>
          <span class="issue-jp">創刊号 · PHNOM PENH</span>
        </div>
        <div class="cover-emblem" aria-hidden="true">
          <span class="cover-hr">HR</span>
          <span class="cover-seal">開発</span>
        </div>
        <p class="cover-title">HOENG<br/><span>REAKSA</span></p>
        <p class="cover-khmer" lang="km">ហុឹង រក្សា — អ្នកអភិវឌ្ឍន៍គេហទំព័រ</p>
        <p class="cover-sub">FULL-STACK DEVELOPER · フルスタック開発者</p>
        <div class="cover-checks" aria-hidden="true">
          <span>✓ OFFLINE PWA</span>
          <span>✓ LARAVEL + REACT</span>
          <span>✓ GITHUB REPOS</span>
          <span>✓ 1,100+ MOD DOWNLOADS</span>
        </div>
        <div class="cover-cta-wrap">
          <span class="cover-cta" id="coverStart">▶ OPEN MANGA · 読む</span>
          <span class="cover-sfx" aria-hidden="true">ドン!!</span>
        </div>
        <p class="cover-hint">CLICK ANYWHERE OR PRESS ENTER</p>
      </div>
    </div>
  </div>

  <a class="skip" href="#main">Skip to content</a>

  <!-- ═══════════ STICKY MANGA CHAPTER HEADER + PROGRESS BAR ═══════════ -->
  <header class="manga-nav" id="hud">
    <div class="nav-progress" id="navProgress" aria-hidden="true"></div>
    <div class="nav-inner">
      <a class="nav-brand" href="#top" data-pop="HERO!">
        <span class="brand-mark">HR</span>
        <span class="brand-txt">巻01<em>PORTFOLIO</em></span>
      </a>

      <button class="nav-burger" id="hudMenu" type="button" aria-expanded="false" aria-controls="hudNav" aria-label="Toggle chapter menu" data-pop="MENU!">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>

      <nav id="hudNav" aria-label="Chapters">
        <a href="#origin" data-ch="02" data-pop="ORIGIN!">Origin</a>
        <a href="#experience" data-ch="03" data-pop="STORY ARCS!">Arcs</a>
        <a href="#work" data-ch="04" data-pop="WORK &amp; MODS!">Work &amp; Mods</a>
        <a href="#opensource" data-ch="05" data-pop="PUBLIC REPOS!">Repos</a>
        <a href="#education" data-ch="06" data-pop="TRAINING!">Training</a>
        <a href="#contact" data-ch="終" data-pop="CONTACT!">Contact</a>
      </nav>

      <div class="nav-tools">
        <span class="folio-live" id="folioLive" aria-hidden="true">P.01/07</span>
        <button class="comic-pill theme-btn" id="themeToggle" type="button" aria-pressed="false" aria-label="Switch to dark ink mode" title="Toggle Paper / Midnight Ink mode" data-pop="INK!">
          <span class="tp-day" aria-hidden="true">昼 PAPER</span>
          <span class="tp-night" aria-hidden="true">夜 INK</span>
        </button>
        <button class="comic-pill" id="sfxToggle" type="button" aria-pressed="true" title="Toggle G-Pen scratch & comic sound effects" data-pop="SFX!">SFX:ON</button>
      </div>
    </div>
  </header>

  <!-- ═══════════ CUSTOM MANGA TANKŌBON SIDE SCROLL GAUGE ═══════════ -->
  <aside class="manga-scroll-gauge" id="mangaGauge" aria-label="Manga page scroll gauge">
    <div class="mg-cap">巻01</div>
    <div class="mg-track" id="mgTrack" title="Click or drag to scrub through the manga">
      <div class="mg-ticks" aria-hidden="true"></div>
      <div class="mg-fill" id="mgFill"></div>
      <div class="mg-thumb" id="mgThumb"><span id="mgPage">P.01</span></div>
    </div>
    <div class="mg-chapters">
      <a href="#top" class="sp-dot active" data-sec="top" data-pop="HERO!" title="Ch.01 Hero"><span>01</span><em>HERO</em></a>
      <a href="#origin" class="sp-dot" data-sec="origin" data-pop="ORIGIN!" title="Ch.02 Origin & Skills"><span>02</span><em>SKILLS</em></a>
      <a href="#experience" class="sp-dot" data-sec="experience" data-pop="STORY ARCS!" title="Ch.03 Story Arcs"><span>03</span><em>ARCS</em></a>
      <a href="#work" class="sp-dot" data-sec="work" data-pop="WORK &amp; MODS!" title="Ch.04 Work & Mods"><span>04</span><em>WORK</em></a>
      <a href="#opensource" class="sp-dot" data-sec="opensource" data-pop="PUBLIC REPOS!" title="Ch.05 Public Repos"><span>05</span><em>REPOS</em></a>
      <a href="#education" class="sp-dot" data-sec="education" data-pop="TRAINING!" title="Ch.06 Training"><span>06</span><em>EDU</em></a>
      <a href="#contact" class="sp-dot" data-sec="contact" data-pop="CONTACT!" title="Final Contact"><span>終</span><em>END</em></a>
    </div>
  </aside>

  <main id="main" class="manga-page">

    <!-- ═══════════ SPREAD 01 · DOUBLE-PAGE HERO SPLASH ═══════════ -->
    <section class="manga-panel hero-panel reveal stagger" id="top" aria-label="Introduction" data-sfx="ドン!!">
      <div class="panel-strip" data-pop="HERO!">
        <span class="ch-tag">第01話 // PROTAGONIST SPLASH</span>
        <span class="jp-tag">主人公プロフィール · PHNOM PENH</span>
        <span class="folio">P.01</span>
      </div>

      <div class="hero-spread">
        <div class="hero-main">
          <div class="hero-kicker">
            <span class="kicker-stamp">FULL-STACK DEVELOPER</span>
            <span class="kicker-jp">フルスタック開発者</span>
          </div>

          <h1 class="hero-name">
            <span class="name-line">HOENG</span>
            <span class="name-line accent-line">REAKSA</span>
          </h1>

          <p class="khmer-tag" lang="km">
            <span class="kh-dot" aria-hidden="true">
              <svg class="ico-svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 1 15 9l8 3-8 3-3 8-3-8-8-3 8-3 3-8Z"/></svg>
            </span>
            ហុឹង រក្សា — អ្នកអភិវឌ្ឍន៍គេហទំព័រ
          </p>

          <div class="speech-bubble hero-bubble">
            <span class="bubble-tag" aria-hidden="true">DIALOGUE // 01</span>
            <p id="heroQuote">
              “I build <em>offline-first sales apps</em> and the <em>Laravel APIs</em> behind them.
              I also write Minecraft mods on the side.”
            </p>
          </div>

          <div class="char-stats">
            <div class="cstat"><b>BASE // 拠点</b><span>Phnom Penh, KH</span></div>
            <div class="cstat"><b>GUILD // 所属</b><span>DaunPenh Data Center</span></div>
            <div class="cstat"><b>SPECIALTY // 技</b><span>Offline PWA + APIs</span></div>
            <div class="cstat"><b>CURSEFORGE // 実績</b><span id="heroCfStat">1,136+ Mod Downloads</span></div>
          </div>

          <div class="hero-ctas">
            <a class="comic-btn primary" href="mailto:hongraksa097@gmail.com" data-pop="SENT!">
              <span>
                <svg class="ico-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                SEND MESSAGE
              </span>
            </a>
            <a class="comic-btn secondary" href="https://t.me/ReaksaNamikaze" target="_blank" rel="me noopener" data-pop="GO!!">
              <span>
                <svg class="ico-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M21.9 4.4c.3-1.3-1-2.3-2.1-1.8L2.6 9.3c-1.3.5-1.2 2.4.2 2.7l4.4 1.4 1.7 5.3c.4 1.2 1.9 1.5 2.8.6l2.5-2.5 4.8 3.5c1.1.8 2.6.2 2.9-1.1L21.9 4.4ZM8.6 12.8l9.2-5.7c.2-.1.4.2.2.4l-7.6 6.9-.3 3.2-1.5-4.8Z"/></svg>
                TELEGRAM
              </span>
            </a>
            <a class="comic-btn ghost" href="#curseforge" data-pop="CURSEFORGE!">
              <span>
                <svg class="ico-svg" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M18.326 9.214S23.226 8.44 24 6.188h-7.506V4.4H0l2.032 2.184V9.23s5.167-.266 7.167 1.24c2.772 2.516-3.087 5.915-3.087 5.915L5.125 19.6c1.587-1.535 4.559-3.435 10.065-3.362-2.094.663-4.189 1.664-5.735 3.362h10.858l-1.276-3.215s-7.916-4.688-.711-7.171Z"/></svg>
                CURSEFORGE STATS
              </span>
            </a>
          </div>
        </div>

        <!-- 3D Tilt + Permanent Manga Ink B&W + Click-to-Flip Shonen Card -->
        <figure class="hero-portrait tilt-card" id="pfCard" data-tilt data-fx="manga" role="button" tabindex="0" aria-label="Hoeng Reaksa portrait card — click to flip between front and character stats">
          <div class="pf-flipper" id="pfFlipper">
            <!-- CARD FRONT -->
            <div class="pf-face pf-front">
              <div class="pf-holo" aria-hidden="true"></div>
              <div class="portrait-speed" aria-hidden="true"></div>
              <div class="portrait-bubble" id="portraitBubble" aria-hidden="true">
                <span>READY TO SHIP!</span>
                <em>オフライン対応!</em>
              </div>

              <div class="pf-card-top">
                <span class="pf-rarity" id="pfRarity">№ 001 // INK</span>
                <span class="pf-live"><i aria-hidden="true"></i>PHNOM PENH</span>
              </div>

              <div class="portrait-frame" id="pfStage">
                <img src="/photo.jpg" alt="Hoeng Reaksa" width="520" height="520" />
                <div class="portrait-halftone" aria-hidden="true"></div>
                <div class="pf-holo-foil" aria-hidden="true"></div>
                <div class="pf-corners" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                <span class="pf-hint" aria-hidden="true">
                  CLICK TO FLIP
                  <svg class="ico-svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </span>
                <span class="portrait-sfx" id="pfSfxTag" aria-hidden="true">INKED!</span>
              </div>

              <figcaption class="pf-footer">
                <span class="pf-cap-txt">
                  CLICK CARD // STATS
                  <svg class="ico-svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </span>
                <button type="button" class="mode-ping" id="quoteCycle" title="Cycle protagonist quote" data-pop="NEXT!">
                  <svg class="ico-svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
                  NEXT LINE
                </button>
              </figcaption>
            </div>

            <!-- CARD BACK (SHONEN CHARACTER STATS SHEET) -->
            <div class="pf-face pf-back" aria-hidden="true">
              <div class="pf-holo" aria-hidden="true"></div>
              <div class="pf-back-head">
                <span class="pf-rarity">CHARACTER SHEET</span>
                <span class="pf-card-no">VOL.01 · INK</span>
              </div>

              <div class="pf-back-id">
                <strong>HOENG REAKSA</strong>
                <span>CLASS: FULL-STACK BUILDER</span>
              </div>

              <div class="pf-bars">
                <div class="pf-bar-row"><span>FRONTEND</span><div class="pf-bar"><i style="width:94%"></i></div><b>94</b></div>
                <div class="pf-bar-row"><span>BACKEND</span><div class="pf-bar"><i style="width:92%"></i></div><b>92</b></div>
                <div class="pf-bar-row"><span>OFFLINE SYNC</span><div class="pf-bar"><i style="width:96%"></i></div><b>96</b></div>
                <div class="pf-bar-row"><span>MC MODDING</span><div class="pf-bar"><i style="width:88%"></i></div><b>88</b></div>
              </div>

              <div class="pf-passive">
                <em>PASSIVE // IDEMPOTENT SYNC</em>
                <p>Orders queue safely offline and transmit once without duplicates.</p>
              </div>

              <div class="pf-back-foot">
                <span class="pf-trophies">
                  <svg class="ico-svg" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2Z"/></svg>
                  5 GH BADGES · 1,136+ DL
                </span>
                <span class="pf-flip-cue">
                  CLICK TO FLIP
                  <svg class="ico-svg" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                </span>
              </div>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- ═══════════ SPREAD 02 · ORIGIN + INTERACTIVE ABILITY ARSENAL ═══════════ -->
    <section class="manga-panel reveal stagger" id="origin" aria-label="About and Tech Stack" data-sfx="シャキーン!">
      <div class="panel-strip" data-pop="ORIGIN!">
        <span class="ch-tag">第02話 // ORIGIN &amp; ABILITY ARSENAL</span>
        <span class="jp-tag">オリジン編・必殺技</span>
        <span class="folio">P.02</span>
      </div>

      <div class="bento-origin">
        <!-- Left Manga Narrative Column with Interactive Story Beat Tabs -->
        <div class="origin-col">
          <div class="sec-head compact-head">
            <h2>Origin</h2>
            <span class="sec-sfx" aria-hidden="true">物語</span>
          </div>

          <div class="beat-tabs" id="beatTabs" role="tablist" aria-label="Story chapters">
            <button type="button" role="tab" aria-selected="true" class="beat-tab active" data-beat="craft" data-pop="01!">01 CRAFT</button>
            <button type="button" role="tab" aria-selected="false" class="beat-tab" data-beat="journey" data-pop="02!">02 JOURNEY</button>
            <button type="button" role="tab" aria-selected="false" class="beat-tab" data-beat="modding" data-pop="03!">03 MODDING</button>
          </div>

          <div class="narrative-stage">
            <div class="beat-pane active" data-pane="craft">
              <span class="narration-box">NARRATION // PHNOM PENH, CAMBODIA</span>
              <p>
                I'm a <em>full-stack developer</em> in Phnom Penh shipping production systems for
                Cambodia's distribution industry: a sales-force app that reps use on the road
                <em>without signal</em>, and the Laravel platform that approves, syncs, and reports
                those orders.
              </p>
              <div class="mini-callout">
                <span>END-TO-END OWNERSHIP</span>
                <em>UI → API → DB</em>
              </div>
            </div>

            <div class="beat-pane" data-pane="journey">
              <span class="narration-box yellow">CURRENT CHAPTER // 2024–2026</span>
              <p>
                I work at <em>DaunPenh Data Center</em> now, on production apps, a 2FA service and
                cloud migrations. Before that I built web features at <em>QL Management</em>, and
                I interned at <em>NPIC</em>.
              </p>
              <div class="mini-callout">
                <span>CLEAN UI · HONEST APIS</span>
                <em>信頼性重視!</em>
              </div>
            </div>

            <div class="beat-pane" data-pane="modding">
              <span class="narration-box crimson">SIDE ARC // JAVA &amp; OPEN SOURCE</span>
              <p>
                On my own time I write <em>Java mods for Minecraft</em>. They're on CurseForge with
                over <em>1,100 downloads</em>. I also made <em>Reaksa Arcade</em>, a Flash game portal
                that runs in the browser.
              </p>
              <div class="mini-callout">
                <span>CREATOR: REAKSA9991MC</span>
                <em>1,136+ DL!</em>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Interactive Skill Arsenal -->
        <div class="skills-col" id="stack">
          <div class="sec-head compact-head">
            <h2>Ability Arsenal</h2>
            <span class="sec-sfx" aria-hidden="true">技一覧</span>
          </div>

          <div class="skill-tabs" id="skillTabs" role="tablist" aria-label="Skill categories">
