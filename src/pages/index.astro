              <tr><th>backend</th><td>Laravel, Ruby on Rails, Node.js, Go (Fiber), Python, REST APIs</td></tr>
              <tr><th>data</th><td>MySQL, PostgreSQL, MariaDB, MongoDB, Redis</td></tr>
              <tr><th>delivery</th><td>Docker, GitHub Actions, Vercel, PWA offline sync</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ═══════════ CAREER.LOG ═══════════ -->
      <section class="win" id="experience" aria-label="Experience">
        <div class="wbar">
          <span class="wtitle">■ career.log — Event Viewer</span>
          <span class="wbtns"><i>_</i><i>□</i><i>✕</i></span>
        </div>
        <div class="wpad">
          <div class="xrow">
            <span class="xdate">08/2025 – present</span>
            <h3>Software Developer · DaunPenh Data Center</h3>
            <p>Production apps and internal services: an offline-first sales-force platform, reporting APIs, self-hosted 2FA, cloud migrations.</p>
            <p class="tech">Next.js · Laravel · Rails · Go · PostgreSQL · MongoDB · Redis · Docker</p>
          </div>
          <div class="xrow">
            <span class="xdate">02/2025 – 08/2025</span>
