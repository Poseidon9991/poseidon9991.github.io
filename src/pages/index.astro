<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="desktop">
    <main id="main" class="desk-inner">

      <!-- ═══════════ WELCOME.EXE ═══════════ -->
      <section class="win" id="top" aria-label="Welcome">
        <div class="wbar">
          <span class="wtitle">■ welcome.exe — Hoeng Reaksa's Homepage</span>
