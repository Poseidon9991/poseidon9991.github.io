  <style is:global>
    :root {
      --sky-a: #8FD9FF;
      --sky-b: #45B5E8;
      --sky-c: #A8E8CC;
      --deep: #07405E;
      --body-ink: #123A52;
      --aqua: #00B7E5;
      --aqua-deep: #0080B0;
      --lime: #58C920;
      --magenta: #FF4FA3;
      --sun: #FFD447;
      --term-bg: #04283E;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; scroll-padding-top: 76px; }

    body {
      margin: 0;
      font-family: 'Nunito', 'Kantumruy Pro', system-ui, sans-serif;
      font-size: 15.5px;
      line-height: 1.65;
      color: var(--body-ink);
      background:
        radial-gradient(1200px 500px at 85% -5%, rgba(255, 255, 255, .55), transparent 60%),
        radial-gradient(900px 420px at -10% 20%, rgba(168, 232, 204, .5), transparent 55%),
        linear-gradient(180deg, var(--sky-a) 0%, var(--sky-b) 55%, var(--sky-c) 100%);
      background-attachment: fixed;
      min-height: 100vh;
      overflow-x: clip;
    }

    /* CRT scanlines, very subtle */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 60;
      pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(4, 30, 46, .05) 0 1px, transparent 1px 3px);
    }

    a { color: var(--aqua-deep); text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
    a:hover { color: var(--deep); }

    :focus-visible {
      outline: 3px solid var(--aqua-deep);
      outline-offset: 2px;
      border-radius: 8px;
    }

    .skip {
      position: fixed;
      top: -60px;
      left: 12px;
      z-index: 70;
      background: #fff;
      color: var(--deep);
      padding: 10px 16px;
      font-weight: 800;
      border-radius: 10px;
      box-shadow: 0 8px 20px rgba(7, 64, 94, .25);
      transition: top .15s;
    }
    .skip:focus { top: 12px; }

    /* ── scroll reveal (only when JS present) ── */
    .js .reveal { opacity: 0; transform: translateY(26px) scale(.985); }
    .js .reveal.visible { opacity: 1; transform: none; }
    .js .reveal.stagger > * { opacity: 0; transform: translateY(14px); }
    .js .reveal.stagger.visible > * { opacity: 1; transform: none; }
    .js .reveal,
    .js .reveal.stagger > * {
      transition-property: opacity, transform, translate, scale, box-shadow;
      transition-duration: .65s, .65s, .2s, .2s, .25s;
      transition-timing-function: ease, cubic-bezier(.22, 1, .36, 1), ease, ease, ease;
    }
    .js .reveal.stagger > *:nth-child(2) { transition-delay: .07s, .07s, 0s, 0s, 0s; }
    .js .reveal.stagger > *:nth-child(3) { transition-delay: .14s, .14s, 0s, 0s, 0s; }
    .js .reveal.stagger > *:nth-child(4) { transition-delay: .21s, .21s, 0s, 0s, 0s; }
    .js .reveal.stagger > *:nth-child(5) { transition-delay: .28s, .28s, 0s, 0s, 0s; }
    .js .reveal.stagger > *:nth-child(6) { transition-delay: .35s, .35s, 0s, 0s, 0s; }
    .js .reveal.stagger > *:nth-child(7) { transition-delay: .42s, .42s, 0s, 0s, 0s; }
    .js .reveal.stagger > *:nth-child(8) { transition-delay: .49s, .49s, 0s, 0s, 0s; }
    .js .reveal.stagger > *:nth-child(n+9) { transition-delay: .56s, .56s, 0s, 0s, 0s; }

    /* ── bubbles (Frutiger Aero) ────────────── */
    .bubbles {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
    }
    .bubbles span {
      position: absolute;
      bottom: -80px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 32% 28%, rgba(255, 255, 255, .95) 0 12%, rgba(255, 255, 255, .22) 45%, rgba(255, 255, 255, .05) 70%);
      border: 1px solid rgba(255, 255, 255, .5);
      box-shadow: inset -6px -8px 14px rgba(255, 255, 255, .35), 0 4px 18px rgba(7, 64, 94, .12);
      animation: rise linear infinite;
    }
    .bubbles span:nth-child(1) { left: 6%;  width: 34px; height: 34px; animation-duration: 17s; animation-delay: -2s; }
    .bubbles span:nth-child(2) { left: 18%; width: 16px; height: 16px; animation-duration: 13s; animation-delay: -7s; }
    .bubbles span:nth-child(3) { left: 31%; width: 46px; height: 46px; animation-duration: 21s; animation-delay: -11s; }
    .bubbles span:nth-child(4) { left: 47%; width: 20px; height: 20px; animation-duration: 15s; animation-delay: -4s; }
    .bubbles span:nth-child(5) { left: 58%; width: 30px; height: 30px; animation-duration: 19s; animation-delay: -9s; }
    .bubbles span:nth-child(6) { left: 69%; width: 14px; height: 14px; animation-duration: 12s; animation-delay: -6s; }
    .bubbles span:nth-child(7) { left: 81%; width: 40px; height: 40px; animation-duration: 23s; animation-delay: -14s; }
    .bubbles span:nth-child(8) { left: 92%; width: 22px; height: 22px; animation-duration: 16s; animation-delay: -3s; }
    @keyframes rise {
      from { transform: translateY(0) translateX(0); }
      25%  { transform: translateY(-30vh) translateX(18px); }
      50%  { transform: translateY(-60vh) translateX(-12px); }
      75%  { transform: translateY(-85vh) translateX(14px); }
      to   { transform: translateY(-115vh) translateX(0); }
    }

    /* ── HUD topbar ─────────────────────────── */
    .hud {
      position: sticky;
      top: 10px;
      z-index: 40;
      display: flex;
      align-items: center;
      gap: 14px;
      max-width: 940px;
      margin: 10px auto 0;
      padding: 8px 12px;
      border-radius: 999px;
      background: linear-gradient(180deg, rgba(255, 255, 255, .75), rgba(255, 255, 255, .4));
      backdrop-filter: blur(14px) saturate(1.4);
      border: 1px solid rgba(255, 255, 255, .9);
      box-shadow: 0 10px 26px rgba(7, 64, 94, .2), inset 0 1px 0 rgba(255, 255, 255, .95);
    }
    .hud-logo {
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: var(--aqua-deep);
      text-decoration: none;
      white-space: nowrap;
      padding: 4px 6px;
    }
    .hud-logo:hover { color: var(--deep); }
    .hud-menu {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 36px;
      height: 36px;
      padding: 8px 7px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, .9);
      background: rgba(255, 255, 255, .55);
      cursor: pointer;
      box-shadow: inset 0 1px 0 #fff;
      margin-left: auto;
    }
    .hud-menu .bar {
      display: block;
      height: 2.5px;
      border-radius: 2px;
      background: var(--deep);
      transition: transform .25s ease, opacity .2s ease;
    }
    .hud.open .hud-menu .bar:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .hud.open .hud-menu .bar:nth-child(2) { opacity: 0; }
    .hud.open .hud-menu .bar:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
    .hud nav {
      display: flex;
      gap: 2px;
      margin-left: auto;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .hud nav::-webkit-scrollbar { display: none; }
    .hud nav a {
      font-weight: 800;
      font-size: 13px;
      color: var(--deep);
      text-decoration: none;
      padding: 5px 11px;
      border-radius: 999px;
      white-space: nowrap;
      transition: background-color .15s, color .15s, box-shadow .15s;
    }
    .hud nav a:hover { background: rgba(255, 255, 255, .8); }
    .hud nav a.active,
    .hud nav a.active:hover {
      background: linear-gradient(180deg, #79DFFF, #12A9DC 60%, #0087B8);
      color: #fff;
      text-shadow: 0 1px 2px rgba(0, 60, 90, .3);
      box-shadow: 0 4px 10px rgba(0, 150, 205, .35), inset 0 1px 0 rgba(255, 255, 255, .7);
    }
    .sfx-toggle {
      flex-shrink: 0;
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      padding: 6px 9px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, .9);
      background: rgba(255, 255, 255, .55);
      color: var(--aqua-deep);
      cursor: pointer;
      box-shadow: inset 0 1px 0 #fff;
      transition: background-color .15s;
    }
    .sfx-toggle:hover { background: rgba(255, 255, 255, .85); }

    /* day/night switch */
    .theme-toggle {
      position: relative;
      flex-shrink: 0;
      width: 54px;
      height: 26px;
      padding: 0;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, .92);
      background: linear-gradient(180deg, #8FE1FA, #33B4E6 55%, #1291C0);
      box-shadow: inset 0 2px 4px rgba(7, 64, 94, .3), inset 0 -1px 0 rgba(255, 255, 255, .4), 0 2px 7px rgba(7, 64, 94, .25);
      cursor: pointer;
      transition: filter .15s ease;
    }
    .theme-toggle:hover { filter: brightness(1.08); }
    .tt-ico {
      position: absolute;
      top: 0;
      width: 50%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      font-style: normal;
      line-height: 1;
    }
    .tt-sun { left: 1px; color: #FFF6CC; text-shadow: 0 1px 2px rgba(7, 64, 94, .45); }
    .tt-moon { right: 1px; color: rgba(223, 243, 255, .8); text-shadow: 0 1px 2px rgba(7, 64, 94, .45); }
    .tt-knob {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 34% 26%, #fff 0 28%, #F0FAFF 48%, #BEE6F6 100%);
      box-shadow: 0 2px 5px rgba(7, 64, 94, .45), inset 0 -2px 3px rgba(0, 128, 176, .28), inset 0 1px 0 #fff;
      transition: translate .25s cubic-bezier(.22, 1, .36, 1), background .25s ease;
    }
    .tt-knob::before { content: '☀'; font-size: 11px; line-height: 1; color: #E8920C; }

    /* ── page & glass cards ─────────────────── */
    .page {
      position: relative;
      z-index: 1;
      max-width: 940px;
      margin: 0 auto;
      padding: 26px 14px 40px;
      display: grid;
      gap: 22px;
    }
    .glass {
      background: linear-gradient(180deg, rgba(255, 255, 255, .74), rgba(255, 255, 255, .42));
      backdrop-filter: blur(16px) saturate(1.35);
      border: 1px solid rgba(255, 255, 255, .88);
      border-radius: 22px;
      box-shadow:
        0 14px 34px rgba(7, 64, 94, .18),
        inset 0 1px 0 rgba(255, 255, 255, .95);
      padding: clamp(20px, 4vw, 34px);
    }
    .glass > :last-child { margin-bottom: 0; }

    .eyebrow {
      margin: 0 0 10px;
      font-family: 'Press Start 2P', monospace;
      font-size: 9px;
      letter-spacing: .06em;
      color: var(--aqua-deep);
    }
    .eyebrow.sub { margin-top: 30px; }

    h2 {
      margin: 0 0 16px;
      font-size: clamp(1.5rem, 3vw, 1.9rem);
      font-weight: 800;
      color: var(--deep);
      letter-spacing: -.01em;
    }
    h2::after {
      content: '';
      display: block;
      width: 76px;
      height: 5px;
      margin-top: 7px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--aqua), var(--lime));
      box-shadow: 0 2px 6px rgba(0, 183, 229, .4);
    }
    .glass p { max-width: 68ch; }

    /* ── hero ───────────────────────────────── */
    .hero-flex {
      display: flex;
      flex-wrap: wrap;
      gap: 26px;
      align-items: flex-start;
    }
    .hero-main { flex: 1 1 340px; min-width: 0; }
    h1 {
      margin: 0;
      font-size: clamp(2.6rem, 8vw, 4.2rem);
      font-weight: 800;
      line-height: .95;
      letter-spacing: -.02em;
      background: linear-gradient(180deg, #FFFFFF 0%, #C9EEFF 32%, #57A9DC 50%, #E9F8FF 54%, #6FC3EC 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 3px 4px rgba(7, 64, 94, .3));
    }
    .khmer {
      margin: 12px 0 0;
      font-family: 'Kantumruy Pro', sans-serif;
      font-size: 1.05rem;
      color: var(--deep);
    }
    .role {
      margin: 10px 0 0;
      font-weight: 800;
      font-size: 1.15rem;
      color: var(--aqua-deep);
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .statement { margin: 12px 0 0; }
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 10px;
      margin: 20px 0 0;
      padding: 14px;
      border-radius: 14px;
      background: rgba(255, 255, 255, .5);
      border: 1px solid rgba(255, 255, 255, .85);
    }
    .stats b {
      display: block;
      font-family: 'Press Start 2P', monospace;
      font-size: 7.5px;
      color: var(--aqua-deep);
      margin-bottom: 4px;
    }
    .stats span { font-weight: 700; font-size: 13.5px; color: var(--deep); }
    .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
    .btn {
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 22px;
      border-radius: 999px;
      font-weight: 800;
      font-size: 14.5px;
      text-decoration: none;
      color: #fff;
      text-shadow: 0 1px 2px rgba(0, 60, 90, .35);
      background: linear-gradient(180deg, #79DFFF 0%, #12A9DC 55%, #0087B8 100%);
      border: 1px solid rgba(255, 255, 255, .75);
      box-shadow:
        0 8px 18px rgba(0, 150, 205, .38),
        inset 0 1px 0 rgba(255, 255, 255, .85),
        inset 0 -2px 4px rgba(0, 70, 105, .25);
      transition: transform .12s, box-shadow .12s;
    }
    .btn:hover { transform: translateY(-1px) scale(1.02); box-shadow: 0 10px 22px rgba(0, 150, 205, .45), inset 0 1px 0 rgba(255, 255, 255, .85); }
    .btn:active { transform: translateY(1px) scale(.98); }
    .btn.alt {
      background: linear-gradient(180deg, #FFE98F 0%, #FFC93C 55%, #F0A400 100%);
      box-shadow: 0 8px 18px rgba(240, 164, 0, .4), inset 0 1px 0 rgba(255, 255, 255, .9), inset 0 -2px 4px rgba(160, 100, 0, .25);
    }
    .press-start {
      margin: 20px 0 0;
      font-family: 'Press Start 2P', monospace;
      font-size: 11px;
      color: var(--magenta);
      animation: blink 1.2s steps(1, end) infinite;
    }
    @keyframes blink { 50% { opacity: 0; } }

    .avatar {
      margin: 0;
      flex: 0 0 auto;
      width: clamp(150px, 26vw, 210px);
      padding: 10px 10px 8px;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, .9), rgba(230, 246, 255, .55));
      border: 1px solid rgba(255, 255, 255, .95);
      box-shadow: 0 12px 26px rgba(7, 64, 94, .2), inset 0 1px 0 #fff;
      position: relative;
      overflow: hidden;
    }
    .avatar::before {
      content: '';
      position: absolute;
      top: -60%;
      left: -30%;
      width: 55%;
      height: 160%;
      background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .75), transparent);
      transform: rotate(12deg);
      animation: shine 4.5s ease-in-out infinite;
    }
    .avatar:hover { translate: 0 -4px; box-shadow: 0 16px 32px rgba(7, 64, 94, .26), inset 0 1px 0 #fff; }
    @keyframes shine {
      0%, 55% { left: -35%; }
      100% { left: 130%; }
    }
    .avatar img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, .8);
    }
    .avatar figcaption {
      margin-top: 6px;
      text-align: center;
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: var(--aqua-deep);
    }

    /* ── terminal panels (code + 3D) ────────── */
    .term {
      clear: both;
      margin-top: 24px;
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(6, 44, 66, .94), var(--term-bg));
      border: 1px solid rgba(120, 220, 255, .35);
      box-shadow:
        inset 0 0 30px rgba(0, 183, 229, .12),
        0 10px 24px rgba(4, 40, 62, .35);
      overflow: hidden;
    }
    .term-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border-bottom: 1px solid rgba(120, 220, 255, .2);
    }
    .term-bar i {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .term-bar i:nth-child(1) { background: radial-gradient(circle at 35% 30%, #B9F3FF, var(--aqua)); }
    .term-bar i:nth-child(2) { background: radial-gradient(circle at 35% 30%, #D5FFC0, var(--lime)); }
    .term-bar i:nth-child(3) { background: radial-gradient(circle at 35% 30%, #FFD1E8, var(--magenta)); }
    .term-bar span {
      margin-left: 8px;
      font-family: 'Press Start 2P', monospace;
      font-size: 7.5px;
      color: #8FD9FF;
      letter-spacing: .05em;
    }
    .term .code {
      margin: 0;
      padding: 14px 16px;
      overflow-x: auto;
      font-family: 'Courier New', Courier, monospace;
      font-size: 13px;
      line-height: 1.6;
      color: #BDEFFF;
      white-space: pre;
    }
    .term .shell {
      height: 192px;
      overflow-y: auto;
      padding: 12px 14px;
      font-family: 'Courier New', Courier, monospace;
      font-size: 12.5px;
      line-height: 1.55;
      color: #BDEFFF;
      cursor: text;
    }
    .term .shell .out div { white-space: pre-wrap; }
    .term .shell .line-in { color: #8FD9FF; }
    .term .in-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .term .ps1 { color: var(--lime); font-weight: 700; }
    .term #shellIn {
      flex: 1;
      min-width: 60px;
      background: transparent;
      border: 0;
      outline: 0;
      padding: 0;
      color: #BDEFFF;
      font: inherit;
      caret-color: var(--sun);
    }
    .term #syncv {
      display: block;
      width: 100%;
      background: #04283E;
    }
    .tlbrow {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 8px 12px;
      border-top: 1px solid rgba(120, 220, 255, .15);
    }
    .tbtn {
      position: relative;
      overflow: hidden;
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      letter-spacing: .04em;
      padding: 8px 11px;
      border-radius: 8px;
      border: 1px solid rgba(120, 220, 255, .45);
      background: rgba(0, 183, 229, .16);
      color: #BDEFFF;
      cursor: pointer;
      transition: background-color .12s, box-shadow .12s;
    }
    .tbtn:hover { background: rgba(0, 183, 229, .34); box-shadow: 0 0 12px rgba(0, 183, 229, .35); }
    .tbtn:active { transform: translateY(1px); }
    .tbtn.danger {
      border-color: rgba(255, 79, 163, .6);
      background: rgba(255, 79, 163, .22);
      color: #FFD1E8;
    }
    .tbtn.danger:hover { background: rgba(255, 79, 163, .38); box-shadow: 0 0 12px rgba(255, 79, 163, .4); }
    .term-cap {
      margin: 0;
      padding: 8px 14px 10px;
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: #7FB8D8;
      border-top: 1px solid rgba(120, 220, 255, .15);
    }
    .dbterm { margin-top: 28px; }
    .lab-intro {
      margin: 0;
      padding: 12px 16px 4px;
      color: #9BDCFF;
      font-size: 13px;
      line-height: 1.65;
      max-width: none;
    }
    .lab-intro b { color: #BDEFFF; }
    .sync-log {
      padding: 8px 16px 10px;
      border-top: 1px solid rgba(120, 220, 255, .15);
      font-family: 'Courier New', Courier, monospace;
      font-size: 11.5px;
      line-height: 1.7;
      color: #BDEFFF;
      min-height: 70px;
    }
    .sync-log:empty { display: none; }
    .sync-log .log-line.q { color: #FFD447; }
    .sync-log .log-line.s { color: #39FF14; }
    .sync-log .log-line.off { color: #FF4FA3; }
    .sync-log .log-line.on { color: #7DF3FF; }

    /* ── skill chips ────────────────────────── */
    .srow {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 14px 0;
      border-bottom: 1px solid rgba(7, 64, 94, .12);
    }
    .srow:first-of-type { border-top: 1px solid rgba(7, 64, 94, .12); }
    .srow:last-of-type { border-bottom: 0; }
    .grp {
      font-family: 'Press Start 2P', monospace;
      font-size: 8px;
      color: var(--aqua-deep);
      padding-top: 6px;
    }
    .chips { display: flex; flex-wrap: wrap; gap: 7px; margin: 0; }
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 13px;
      border-radius: 999px;
      font-weight: 800;
      font-size: 13px;
      color: var(--deep);
      background: linear-gradient(180deg, #FFFFFF, #DCF3FC 60%, #BFE6F7);
      border: 1px solid rgba(255, 255, 255, .95);
      box-shadow: inset 0 1px 0 #fff, 0 3px 7px rgba(7, 64, 94, .12);
      transition: translate .18s ease, scale .18s ease, box-shadow .18s ease;
    }
    .chip:hover {
      translate: 0 -3px;
      scale: 1.05;
      box-shadow: inset 0 1px 0 #fff, 0 7px 16px rgba(0, 150, 205, .28);
    }
    .chip:active { scale: .97; translate: 0 -1px; }
    .chip img { width: 15px; height: 15px; display: block; }
    .chip .ico-glyph {
      font-style: normal;
      font-size: 13px;
      font-weight: 900;
      color: var(--aqua-deep);
      line-height: 1;
    }
    .chip.sm { font-size: 12px; padding: 3px 11px; }

    /* ── quests (experience) ────────────────── */
    .quest {
      padding: 16px 18px;
      border-radius: 16px;
      background: rgba(255, 255, 255, .5);
      border: 1px solid rgba(255, 255, 255, .85);
      box-shadow: inset 0 1px 0 #fff;
      margin-bottom: 12px;
      transition: translate .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .quest:hover {
      translate: 0 -3px;
      border-color: #fff;
      box-shadow: inset 0 1px 0 #fff, 0 12px 24px rgba(7, 64, 94, .18), 0 0 0 1px rgba(0, 183, 229, .2);
    }
    .quest:last-child { margin-bottom: 0; }
    .qdate {
      display: inline-block;
      padding: 4px 12px;
      margin-bottom: 8px;
      border-radius: 999px;
      font-family: 'Press Start 2P', monospace;
      font-size: 7.5px;
      color: #fff;
      text-shadow: 0 1px 2px rgba(0, 60, 90, .3);
      background: linear-gradient(180deg, #79DFFF, #12A9DC 60%, #0087B8);
      border: 1px solid rgba(255, 255, 255, .7);
      box-shadow: 0 4px 10px rgba(0, 150, 205, .35), inset 0 1px 0 rgba(255, 255, 255, .7);
    }
    .quest h3 { margin: 4px 0 6px; font-size: 1.05rem; font-weight: 800; color: var(--deep); }
    .quest p { margin: 0 0 8px; }

    /* ── levels (plates) ────────────────────── */
    .level {
      padding: 18px 20px;
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, .62), rgba(255, 255, 255, .34));
      border: 1px solid rgba(255, 255, 255, .9);
      box-shadow: inset 0 1px 0 #fff, 0 8px 18px rgba(7, 64, 94, .1);
      margin-bottom: 18px;
      transition: translate .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .level:hover {
      translate: 0 -4px;
      border-color: #fff;
      box-shadow: inset 0 1px 0 #fff, 0 16px 32px rgba(7, 64, 94, .18), 0 0 0 1px rgba(0, 183, 229, .25);
    }
    .level:last-of-type { margin-bottom: 0; }
    .level-head {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 10px;
    }
    .lvl-no {
      font-family: 'Press Start 2P', monospace;
      font-size: 26px;
      color: transparent;
      background: linear-gradient(180deg, #9FE8FF, #0087B8);
      -webkit-background-clip: text;
      background-clip: text;
      filter: drop-shadow(0 2px 2px rgba(7, 64, 94, .25));
      flex-shrink: 0;
    }
    .lvl-no { transition: scale .25s ease, rotate .25s ease; }
    .level:hover .lvl-no { scale: 1.12; rotate: -3deg; }
    .lvl-title h3 { margin: 0 0 3px; font-size: 1.1rem; font-weight: 800; color: var(--deep); }
    .lvl-tag {
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: var(--aqua-deep);
      letter-spacing: .04em;
    }
    .level > p { margin: 8px 0 10px; }
    .level .chips { margin: 0 0 12px; }
    .level .term { margin-top: 4px; }

    /* ── side quests ────────────────────────── */
    .sidequests { list-style: none; margin: 0; padding: 0; }
    .sidequests li {
      padding: 9px 6px 9px 14px;
      border-bottom: 1px dashed rgba(7, 64, 94, .2);
      font-size: 14px;
      transition: translate .18s ease, background-color .18s ease;
      border-radius: 8px;
    }
    .sidequests li:hover { translate: 5px 0; background: rgba(255, 255, 255, .5); }
    .sidequests li:last-child { border-bottom: 0; }
    .sidequests b { color: var(--aqua-deep); font-family: 'Courier New', monospace; }

    /* ── achievements ───────────────────────── */
    .achv {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 16px 18px;
      border-radius: 16px;
      background: rgba(255, 255, 255, .5);
      border: 1px solid rgba(255, 255, 255, .85);
      box-shadow: inset 0 1px 0 #fff;
      margin-bottom: 12px;
      transition: translate .2s ease, box-shadow .2s ease;
    }
    .achv:hover {
      translate: 0 -3px;
      box-shadow: inset 0 1px 0 #fff, 0 12px 24px rgba(88, 201, 32, .2), 0 0 0 1px rgba(88, 201, 32, .25);
    }
    .achv:last-child { margin-bottom: 0; }
    .achv-ico {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      font-size: 20px;
      color: #fff;
      text-shadow: 0 1px 2px rgba(40, 90, 10, .4);
      background: radial-gradient(circle at 32% 28%, #CFF7A8, var(--lime) 65%, #3E9B0F);
      border: 2px solid rgba(255, 255, 255, .9);
      box-shadow: 0 6px 14px rgba(88, 201, 32, .4), inset 0 1px 0 rgba(255, 255, 255, .7);
      transition: scale .25s ease, rotate .25s ease;
    }
    .achv:hover .achv-ico { scale: 1.12; rotate: 8deg; }
    .achv h3 { margin: 2px 0 4px; font-size: 1rem; font-weight: 800; color: var(--deep); }
    .achv p { margin: 0 0 4px; }
    .achv-meta { font-size: 12px; color: var(--aqua-deep); font-weight: 700; margin: 0; }
    .unlocked {
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: #3E9B0F;
      letter-spacing: .05em;
    }

    /* ── continue / contact ─────────────────── */
    .continue { text-align: center; }
    .cont-title {
      font-family: 'Press Start 2P', monospace;
      font-size: clamp(1.2rem, 4vw, 2rem);
      color: var(--magenta);
      text-shadow: 0 3px 0 rgba(255, 79, 163, .25);
      margin: 6px 0 10px;
    }
    .cont-title::after { display: none; }
    .insert {
      font-family: 'Press Start 2P', monospace;
      font-size: 8.5px;
      color: var(--deep);
      animation: blink 1.2s steps(1, end) infinite;
      margin: 0 0 20px;
    }
    .contacts { list-style: none; margin: 0 auto 14px; padding: 0; max-width: 480px; }
    .contacts li { padding: 8px 0; }
    .contacts a {
      position: relative;
      overflow: hidden;
      display: inline-block;
      padding: 9px 20px;
      border-radius: 999px;
      background: rgba(255, 255, 255, .65);
      border: 1px solid rgba(255, 255, 255, .95);
      box-shadow: inset 0 1px 0 #fff, 0 4px 10px rgba(7, 64, 94, .12);
      font-weight: 800;
      font-size: 14px;
      color: var(--deep);
      text-decoration: none;
      transition: transform .12s, background-color .12s;
    }
    .contacts a:hover { transform: translateY(-2px) scale(1.02); background: #fff; color: var(--aqua-deep); box-shadow: inset 0 1px 0 #fff, 0 8px 18px rgba(7, 64, 94, .18); }
    .contacts a:active { transform: translateY(1px) scale(.98); }
    .khmer-c { font-family: 'Kantumruy Pro', sans-serif; margin: 0; color: var(--deep); }

    /* ── scoreboard (footer) ────────────────── */
    .scoreboard { text-align: center; padding: 4px 6px 0; }
    .score {
      font-family: 'Press Start 2P', monospace;
      font-size: 10px;
      color: var(--deep);
      margin: 0 0 14px;
    }
    .score b {
      display: inline-block;
      background: #06283E;
      color: var(--sun);
      padding: 4px 10px;
      margin-left: 10px;
      border-radius: 6px;
      letter-spacing: 4px;
      box-shadow: inset 0 0 12px rgba(255, 212, 71, .35), 0 4px 10px rgba(7, 64, 94, .25);
    }
    .badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 14px; }
    .badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 10px;
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      line-height: 1.5;
      color: var(--deep);
      background: linear-gradient(180deg, rgba(255, 255, 255, .85), rgba(220, 243, 252, .6));
      border: 1px solid rgba(255, 255, 255, .95);
      box-shadow: inset 0 1px 0 #fff, 0 3px 8px rgba(7, 64, 94, .14);
      transition: translate .18s ease, box-shadow .18s ease;
    }
    .badge:hover { translate: 0 -3px; box-shadow: inset 0 1px 0 #fff, 0 8px 16px rgba(7, 64, 94, .2); }
    .footline { margin: 0; font-size: 12.5px; color: var(--body-ink); }

    /* ── boot screen ────────────────────────── */
    .boot {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 13px;
      padding: 24px;
      text-align: center;
      cursor: pointer;
      background:
        radial-gradient(700px 420px at 50% 24%, rgba(0, 183, 229, .18), transparent 70%),
        radial-gradient(900px 600px at 50% 112%, rgba(168, 232, 204, .1), transparent 60%),
        linear-gradient(180deg, #071E30, #04283E 55%, #031C2C);
      transition: opacity .45s ease;
    }
    .js .boot { display: flex; }
    .boot.done { opacity: 0; pointer-events: none; }
    body.booting { overflow: hidden; }
    .boot-coin {
      width: 92px;
      height: 92px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Press Start 2P', monospace;
      font-size: 24px;
      color: #fff;
      text-shadow: 0 2px 0 rgba(0, 90, 130, .45);
      background: linear-gradient(180deg, #8FD9FF, #45B5E8 55%, #00B7E5);
      border: 3px solid rgba(255, 255, 255, .85);
      box-shadow: 0 14px 40px rgba(0, 183, 229, .45), inset 0 2px 0 rgba(255, 255, 255, .7);
    }
    .boot-title {
      margin: 0;
      font-family: 'Press Start 2P', monospace;
      font-size: clamp(13px, 3.4vw, 21px);
      letter-spacing: .08em;
      color: #EAF8FF;
      text-shadow: 0 0 18px rgba(0, 183, 229, .55);
    }
    .boot-sub {
      margin: 0;
      font-family: 'Press Start 2P', monospace;
      font-size: 8px;
      color: #7FB8D8;
    }
    .boot-log {
      min-height: 102px;
      margin: 8px 0 0;
      font-family: 'Courier New', Courier, monospace;
      font-size: 12px;
      line-height: 1.7;
      color: #9BDCFF;
      text-align: left;
    }
    .boot-log .ok { color: #39FF14; font-weight: 700; }
    .boot-start {
      margin: 4px 0 0;
      font-family: 'Press Start 2P', monospace;
      font-size: 13px;
      color: var(--magenta);
      text-shadow: 0 0 14px rgba(255, 79, 163, .55);
      visibility: hidden;
      animation: blink 1.1s steps(1, end) infinite;
    }
    .boot.ready .boot-start { visibility: visible; }
    .boot-hint {
      margin: 0;
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: #5E8CA6;
    }

    /* ── github uplink ──────────────────────── */
    .gh-tiles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 10px;
      margin: 18px 0 22px;
    }
    .gh-tile {
      text-align: center;
      padding: 16px 10px 13px;
      border-radius: 12px;
      background: linear-gradient(180deg, #06304A, #04283E);
      border: 1px solid rgba(120, 220, 255, .3);
      box-shadow: inset 0 0 18px rgba(0, 183, 229, .12), 0 6px 14px rgba(4, 40, 62, .3);
    }
    .gh-tile b {
      display: block;
      font-family: 'Press Start 2P', monospace;
      font-size: 17px;
      color: var(--sun);
      text-shadow: 0 0 12px rgba(255, 212, 71, .5);
      margin-bottom: 7px;
      animation: blink 1s steps(1, end) infinite;
    }
    .gh-tile.on b { animation: none; }
    .gh-tile span {
      font-family: 'Press Start 2P', monospace;
      font-size: 7px;
      color: #7FB8D8;
      letter-spacing: .05em;
    }
    .gh-block { margin: 0 0 22px; }
    .gh-block .grp { display: block; padding-top: 0; margin: 0 0 10px; }
    .lang-rows { display: grid; gap: 9px; max-width: 560px; }
    .lrow { display: grid; grid-template-columns: 96px 1fr 46px; align-items: center; gap: 10px; }
    .lname { font-family: 'Courier New', Courier, monospace; font-weight: 700; font-size: 12.5px; color: var(--deep); }
    .ltrack { display: block; height: 12px; border-radius: 999px; background: rgba(7, 64, 94, .12); overflow: hidden; }
    .lbar {
      display: block;
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--aqua), var(--lime));
      box-shadow: 0 0 8px rgba(0, 183, 229, .4);
      animation: barIn .7s cubic-bezier(.22, 1, .36, 1);
    }
    .lpct { font-family: 'Press Start 2P', monospace; font-size: 7.5px; color: var(--aqua-deep); text-align: right; }
    @keyframes barIn { from { width: 0; } }
    .heat {
      display: grid;
      grid-template-rows: repeat(7, 13px);
      grid-auto-flow: column;
      grid-auto-columns: 13px;
      gap: 3px;
      width: max-content;
      max-width: 100%;
      overflow-x: auto;
      padding: 2px 2px 6px;
    }
    .heat i {
      display: block;
      width: 13px;
      height: 13px;
      border-radius: 3px;
      background: rgba(7, 64, 94, .14);
      animation: cellIn .3s ease both;
    }
    @keyframes cellIn { from { opacity: 0; scale: .4; } }
    .heat i[data-l="1"] { background: #A7E9FF; }
    .heat i[data-l="2"] { background: #4FC9EE; }
    .heat i[data-l="3"] { background: #3FD95F; }
    .heat i[data-l="4"] { background: #FFD447; box-shadow: 0 0 6px rgba(255, 212, 71, .55); }
    .gh-foot { margin: 4px 0 0; }

    /* ── ripple + back-to-top ───────────────── */
    .ripple {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, .45);
      transform: scale(0);
      animation: rippleAnim .6s ease-out forwards;
      pointer-events: none;
    }
    @keyframes rippleAnim { to { transform: scale(1); opacity: 0; } }

    .to-top {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, .9);
      background: linear-gradient(180deg, #79DFFF, #12A9DC 60%, #0087B8);
      color: #fff;
      font-size: 15px;
      cursor: pointer;
      overflow: hidden;
      box-shadow: 0 8px 18px rgba(0, 150, 205, .4), inset 0 1px 0 rgba(255, 255, 255, .85);
      opacity: 0;
      translate: 0 12px;
      pointer-events: none;
      transition: opacity .25s ease, translate .25s ease, box-shadow .2s ease;
    }
    .to-top.show { opacity: 1; translate: 0 0; pointer-events: auto; }
    .to-top:hover { box-shadow: 0 10px 22px rgba(0, 150, 205, .55), inset 0 1px 0 rgba(255, 255, 255, .85); }
    .to-top:active { scale: .92; }

    @keyframes menuIn {
      from { opacity: 0; translate: 0 -6px; }
    }

    /* ── small screens ──────────────────────── */
    @media (max-width: 900px) {
      .page { padding: 22px 12px 36px; gap: 18px; }
    }

    @media (max-width: 720px) {
      .hud-menu { display: inline-flex; }
      .hud nav {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        display: none;
        flex-direction: column;
        gap: 2px;
        padding: 8px;
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(255, 255, 255, .95), rgba(255, 255, 255, .8));
        backdrop-filter: blur(14px) saturate(1.4);
        border: 1px solid rgba(255, 255, 255, .95);
        box-shadow: 0 14px 30px rgba(7, 64, 94, .28), inset 0 1px 0 #fff;
        overflow: visible;
      }
      .hud.open nav { display: flex; animation: menuIn .22s ease; }
      .hud nav a { padding: 11px 14px; font-size: 14px; }

      .hero-flex { flex-direction: column-reverse; align-items: center; }
      .hero-main { width: 100%; flex: none; }
      .avatar { width: min(240px, 76%); }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .cta .btn { flex: 1 1 auto; justify-content: center; }
      .level-head { flex-wrap: wrap; gap: 10px; }
      .contacts a { display: block; }
      .term .shell { height: 170px; }
    }

    @media (max-width: 520px) {
      body { font-size: 15px; }
      .hud { top: 6px; margin-top: 6px; gap: 8px; padding: 6px 10px; }
      .hud-logo { font-size: 8px; }
      .glass { padding: 18px; }
      .avatar { width: min(200px, 80%); }
      .term .code { font-size: 11px; }
      .term .shell { font-size: 11.5px; height: 160px; }
      .lab-intro { font-size: 12px; }
      .stats { padding: 10px; }
      .lvl-no { font-size: 22px; }
      .footline { font-size: 11.5px; }
      .badge { font-size: 6px; }
      .to-top { right: 12px; bottom: 12px; width: 40px; height: 40px; }
    }

    /* ── night mode ─────────────────────────── */
    [data-theme="dark"] {
      --sky-a: #0B1826;
      --sky-b: #0E2742;
      --sky-c: #0F3A2F;
      --deep: #BFE9FF;
      --body-ink: #A9C9DC;
      --aqua-deep: #5FD4FF;
      --term-bg: #031E30;
    }
    [data-theme="dark"] body {
      color: var(--body-ink);
      background:
        radial-gradient(1100px 480px at 82% -8%, rgba(0, 183, 229, .13), transparent 60%),
        radial-gradient(900px 420px at -10% 24%, rgba(18, 84, 66, .2), transparent 55%),
        linear-gradient(180deg, var(--sky-a) 0%, var(--sky-b) 55%, var(--sky-c) 100%);
      background-attachment: fixed;
    }
    [data-theme="dark"] body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        radial-gradient(2px 2px at 11% 9%, #fff 99%, transparent),
        radial-gradient(1.1px 1.1px at 23% 31%, #CFEFFF 99%, transparent),
        radial-gradient(1.3px 1.3px at 15% 58%, #fff 99%, transparent),
        radial-gradient(1px 1px at 31% 79%, #BFE9FF 99%, transparent),
        radial-gradient(1.9px 1.9px at 39% 16%, #fff 99%, transparent),
        radial-gradient(1px 1px at 45% 44%, #CFEFFF 99%, transparent),
        radial-gradient(1.2px 1.2px at 53% 71%, #fff 99%, transparent),
        radial-gradient(1.6px 1.6px at 58% 8%, #EAF8FF 99%, transparent),
        radial-gradient(1px 1px at 65% 37%, #fff 99%, transparent),
        radial-gradient(1.4px 1.4px at 72% 64%, #CFEFFF 99%, transparent),
        radial-gradient(1px 1px at 79% 19%, #fff 99%, transparent),
        radial-gradient(1.7px 1.7px at 85% 49%, #EAF8FF 99%, transparent),
        radial-gradient(1px 1px at 92% 76%, #fff 99%, transparent),
        radial-gradient(1.2px 1.2px at 96% 13%, #CFEFFF 99%, transparent),
        radial-gradient(1px 1px at 47% 89%, #fff 99%, transparent),
        radial-gradient(1.1px 1.1px at 68% 91%, #BFE9FF 99%, transparent),
        radial-gradient(1.3px 1.3px at 88% 92%, #fff 99%, transparent),
        radial-gradient(2.3px 2.3px at 12% 42%, #fff 99%, transparent),
        radial-gradient(2.5px 2.5px at 74% 85%, #EAF8FF 99%, transparent),
        radial-gradient(2.1px 2.1px at 28% 4%, #fff 99%, transparent);
    }
    [data-theme="dark"] body::after {
      background: repeating-linear-gradient(0deg, rgba(0, 0, 0, .22) 0 1px, transparent 1px 3px);
    }
    [data-theme="dark"] .bubbles { display: none; }
    [data-theme="dark"] .glass {
      background: linear-gradient(180deg, rgba(13, 33, 52, .72), rgba(9, 25, 40, .5));
      border-color: rgba(110, 190, 240, .18);
      box-shadow: 0 16px 40px rgba(0, 0, 0, .45), inset 0 1px 0 rgba(140, 220, 255, .08);
    }
    [data-theme="dark"] .hud {
      background: linear-gradient(180deg, rgba(13, 33, 52, .82), rgba(9, 25, 40, .62));
      border-color: rgba(110, 190, 240, .22);
      box-shadow: 0 12px 30px rgba(0, 0, 0, .5), inset 0 1px 0 rgba(140, 220, 255, .1);
    }
    [data-theme="dark"] .hud nav a:hover { background: rgba(95, 212, 255, .13); }
    [data-theme="dark"] .sfx-toggle,
    [data-theme="dark"] .hud-menu {
      background: rgba(13, 33, 52, .72);
      border-color: rgba(110, 190, 240, .25);
      color: #8FD9FF;
      box-shadow: inset 0 1px 0 rgba(140, 220, 255, .1);
    }
    [data-theme="dark"] .sfx-toggle:hover,
    [data-theme="dark"] .hud-menu:hover { background: rgba(13, 33, 52, .95); }
    [data-theme="dark"] .theme-toggle {
      background: linear-gradient(180deg, #1C3D5B, #0C2438 60%, #091C2D);
      border-color: rgba(110, 190, 240, .35);
      box-shadow: inset 0 2px 5px rgba(0, 0, 0, .55), inset 0 -1px 0 rgba(140, 220, 255, .12), 0 2px 7px rgba(0, 0, 0, .4);
    }
    [data-theme="dark"] .theme-toggle:hover { filter: brightness(1.15); }
    [data-theme="dark"] .tt-sun { color: rgba(255, 246, 204, .45); text-shadow: none; }
    [data-theme="dark"] .tt-moon { color: #BFE9FF; text-shadow: 0 1px 2px rgba(0, 0, 0, .5); }
    [data-theme="dark"] .tt-knob {
      translate: 28px 0;
      background: radial-gradient(circle at 34% 26%, #fff 0 22%, #D8F0FF 45%, #8FCDF0 100%);
      box-shadow: 0 2px 6px rgba(0, 0, 0, .6), inset 0 -2px 3px rgba(0, 60, 100, .35), inset 0 1px 0 rgba(255, 255, 255, .8);
    }
    [data-theme="dark"] .tt-knob::before { content: '☾'; color: #0A2540; }
    [data-theme="dark"] .hud-menu .bar { background: #8FD9FF; }
    [data-theme="dark"] h1 {
      background: linear-gradient(180deg, #FFFFFF 0%, #D8F4FF 32%, #6FC8EC 50%, #EAF8FF 54%, #7FD4EE 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(0 3px 6px rgba(0, 0, 0, .55)) drop-shadow(0 0 18px rgba(0, 183, 229, .3));
    }
    [data-theme="dark"] .stats {
      background: rgba(10, 26, 42, .55);
      border-color: rgba(110, 190, 240, .18);
    }
    [data-theme="dark"] .avatar {
      background: linear-gradient(180deg, rgba(16, 38, 58, .85), rgba(10, 26, 42, .5));
      border-color: rgba(110, 190, 240, .25);
      box-shadow: 0 14px 32px rgba(0, 0, 0, .5), inset 0 1px 0 rgba(140, 220, 255, .12);
    }
    [data-theme="dark"] .chip {
      background: linear-gradient(180deg, #16334D, #0E2438);
      border-color: rgba(110, 190, 240, .22);
      box-shadow: inset 0 1px 0 rgba(140, 220, 255, .12), 0 4px 10px rgba(0, 0, 0, .35);
    }
    [data-theme="dark"] .chip:hover { box-shadow: inset 0 1px 0 rgba(140, 220, 255, .12), 0 8px 18px rgba(0, 183, 229, .3); }
    [data-theme="dark"] .quest,
    [data-theme="dark"] .achv {
      background: rgba(10, 26, 42, .5);
      border-color: rgba(110, 190, 240, .18);
    }
    [data-theme="dark"] .quest:hover,
    [data-theme="dark"] .level:hover { border-color: rgba(95, 212, 255, .45); }
    [data-theme="dark"] .level {
      background: linear-gradient(180deg, rgba(13, 33, 52, .6), rgba(9, 25, 40, .35));
      border-color: rgba(110, 190, 240, .2);
    }
    [data-theme="dark"] .sidequests li:hover { background: rgba(10, 26, 42, .55); }
    [data-theme="dark"] .contacts a {
      background: rgba(10, 26, 42, .6);
      border-color: rgba(110, 190, 240, .22);
    }
    [data-theme="dark"] .contacts a:hover { background: #10263C; color: #8FD9FF; }
    [data-theme="dark"] .badge {
      background: linear-gradient(180deg, rgba(13, 33, 52, .85), rgba(9, 25, 40, .6));
      border-color: rgba(110, 190, 240, .2);
    }
    [data-theme="dark"] .skip { background: #0D2134; color: #BFE9FF; }
    [data-theme="dark"] .hud nav {
      background: linear-gradient(180deg, rgba(13, 33, 52, .97), rgba(9, 25, 40, .92));
      border-color: rgba(110, 190, 240, .25);
    }
    [data-theme="dark"] .heat i { background: rgba(95, 212, 255, .08); }
    [data-theme="dark"] .ltrack { background: rgba(95, 212, 255, .1); }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .bubbles span, .avatar::before, .press-start, .insert { animation: none; }
      .bubbles { display: none; }
      .js .reveal, .js .reveal.stagger > * {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; }
    }
  </style>

  <script>
    (() => {
      /* ── scroll reveal ─────────────────────── */
      const io = new IntersectionObserver(entries => {
        for (const en of entries) {
          if (en.isIntersecting) {
            en.target.classList.add('visible');
            io.unobserve(en.target);
          }
        }
      }, { threshold: 0.08, rootMargin: '0px 0px -36px 0px' });
      let shellBootStart = () => {};

      /* ── scrollspy (HUD nav) ───────────────── */
      const navLinks = [...document.querySelectorAll('.hud nav a')];
      const spy = new IntersectionObserver(entries => {
        entries.forEach(en => {
          if (!en.isIntersecting) return;
          navLinks.forEach(a => a.classList.toggle('active', a.hash === '#' + en.target.id));
        });
      }, { rootMargin: '-40% 0px -55% 0px' });
      ['top', 'about', 'stack', 'experience', 'work', 'github', 'education', 'contact']
        .forEach(id => { const el = document.getElementById(id); if (el) spy.observe(el); });

      /* ── mobile HUD menu ───────────────────── */
      const hud = document.getElementById('hud');
      const menuBtn = document.getElementById('hudMenu');
      const closeMenu = () => {
        if (!hud) return;
        hud.classList.remove('open');
        if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
      };
      if (hud && menuBtn) menuBtn.addEventListener('click', () => {
        const open = hud.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', String(open));
      });
      navLinks.forEach(a => a.addEventListener('click', closeMenu));
      document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });

      /* ── back to top ───────────────────────── */
      const toTop = document.getElementById('toTop');
      if (toTop) {
        const syncTop = () => toTop.classList.toggle('show', window.scrollY > 480);
        window.addEventListener('scroll', syncTop, { passive: true });
        syncTop();
        toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      }

      /* ── ripple on press ───────────────────── */
      document.addEventListener('pointerdown', e => {
        const b = e.target.closest('.btn, .tbtn, .contacts a, .to-top');
        if (!b) return;
        const r = b.getBoundingClientRect();
        const d = Math.max(r.width, r.height) * 2;
        const s = document.createElement('span');
        s.className = 'ripple';
        s.style.width = d + 'px';
        s.style.height = d + 'px';
        s.style.left = (e.clientX - r.left - d / 2) + 'px';
        s.style.top = (e.clientY - r.top - d / 2) + 'px';
        b.appendChild(s);
        setTimeout(() => s.remove(), 620);
      });

      /* ── high score counter ────────────────── */
      const v = document.getElementById('visits');
      if (v) {
        try {
          const n = (parseInt(localStorage.getItem('hr_visits') || '0', 10) || 0) + 1;
          localStorage.setItem('hr_visits', String(n));
          v.textContent = String(n).padStart(6, '0');
        } catch (e) { v.textContent = '000001'; }
      }

      /* ── chiptune sfx (Web Audio) ──────────── */
      let sfxOn = true, actx = null;
      try { sfxOn = localStorage.getItem('hr_sfx') !== 'off'; } catch (e) {}
      const beep = (freq, dur, type = 'square', vol = .1, when = 0) => {
        if (!sfxOn) return;
        try {
          if (!actx) actx = new (window.AudioContext || window.webkitAudioContext)();
          if (actx.state === 'suspended') actx.resume();
          const o = actx.createOscillator(), g = actx.createGain();
          const t0 = actx.currentTime + when;
          o.type = type;
          o.frequency.value = freq;
          g.gain.setValueAtTime(vol, t0);
          g.gain.exponentialRampToValueAtTime(.001, t0 + dur);
          o.connect(g);
          g.connect(actx.destination);
          o.start(t0);
          o.stop(t0 + dur + .02);
        } catch (e) {}
      };
      const sfx = {
        click: () => beep(700, .05, 'square', .07),
        key: () => beep(980, .03, 'square', .04),
        enter: () => beep(620, .06, 'triangle', .09),
        coin: () => { beep(880, .06, 'square', .11); beep(1318, .1, 'square', .11, .07); },
        miss: () => beep(140, .16, 'sawtooth', .1),
        start: () => [392, 523, 659].forEach((f, i) => beep(f, .09, 'square', .1, i * .07)),
        over: () => [392, 330, 262, 175].forEach((f, i) => beep(f, .15, 'triangle', .12, i * .11)),
      };
      const sfxBtn = document.getElementById('sfxToggle');
      const syncSfxBtn = () => {
        if (!sfxBtn) return;
        sfxBtn.textContent = sfxOn ? 'SFX:ON' : 'SFX:OFF';
        sfxBtn.setAttribute('aria-pressed', String(sfxOn));
      };
      syncSfxBtn();
      if (sfxBtn) sfxBtn.addEventListener('click', () => {
        sfxOn = !sfxOn;
        try { localStorage.setItem('hr_sfx', sfxOn ? 'on' : 'off'); } catch (e) {}
        syncSfxBtn();
        if (sfxOn) sfx.click();
      });
      document.addEventListener('click', e => {
        const t = e.target.closest('a, button');
        if (t && t.id !== 'sfxToggle') sfx.click();
      });

      /* ── interactive shell (shell.exe) ─────── */
      const out = document.getElementById('shellOut');
      const inp = document.getElementById('shellIn');
      const wrap = document.getElementById('shell');
      if (out && inp && wrap) {
        const sleep = ms => new Promise(r => setTimeout(r, ms));
        const line = (txt = '', cls = '') => {
          const d = document.createElement('div');
          if (cls) d.className = cls;
          d.textContent = txt;
          out.appendChild(d);
          wrap.scrollTop = wrap.scrollHeight;
          return d;
        };
        const CMDS = {
          help: () => ['available commands:',
            '  whoami          who is this player',
            '  skills          loadout',
            '  projects        level select',
            '  contact         reach player 1',
            '  sync            check order queue',
            '  ls              list files',
            '  clear           clear screen',
            '  sudo hire-me    you know what to do'],
          whoami: () => ['hoeng_reaksa · full-stack developer · phnom penh, kh',
            'currently: software developer @ daunpenh data center'],
          skills: () => ['frontend : react, next.js, vue 3, nuxt, astro, tailwind',
            'backend  : laravel, rails, node.js, go (fiber), python',
            'data     : mysql, postgresql, mariadb, mongodb, redis',
            'delivery : docker, github actions, vercel, pwa sync'],
          projects: () => ['01 provida_sfa      offline-first sales platform (pwa)',
            '02 provida_report   laravel order backend',
            '03 totp_shield      self-hosted 2fa service',
            '+ 6 side quests — scroll to LEVEL SELECT'],
          contact: () => ['email    : hongraksa097@gmail.com',
            'telegram : t.me/ReaksaNamikaze',
            'linkedin : hoeng-reaksa-48b5842b3',
            'github   : github.com/Poseidon9991'],
          sync: () => ['[OK] queue: 0 pending · all orders synced ✓'],
          ls: () => ['projects/  skills/  trophies/  contact.txt  readme.md'],
          'sudo hire-me': () => ['permission granted ✓ initiating handshake...',
            '→ hongraksa097@gmail.com'],
        };
        const run = (raw, echo = true) => {
          const cmd = raw.trim();
          if (echo) line('$ ' + cmd, 'line-in');
          if (!cmd) return;
          if (cmd === 'clear') { out.innerHTML = ''; return; }
          const fn = CMDS[cmd];
          if (fn) fn().forEach(l => line(l));
          else line("command not found: " + cmd + "  (try 'help')");
        };
        let shellBooted = false;
        shellBootStart = () => {
          if (shellBooted) return;
          shellBooted = true;
          (async () => {
            await sleep(450);
            run('whoami');
            await sleep(350);
            run('sync');
            await sleep(350);
            line('');
            line("— interactive mode: type 'help' —");
            line('');
          })();
        };
        const hist = []; let hi = 0;
        inp.addEventListener('keydown', e => {
          if (e.key === 'Enter') {
            sfx.enter();
            const v = inp.value;
            inp.value = '';
            if (v.trim()) { hist.push(v); }
            hi = hist.length;
            run(v);
          } else if (e.key.length === 1) {
            sfx.key();
          }
          if (e.key === 'ArrowUp') {
            if (hi > 0) { hi--; inp.value = hist[hi] || ''; e.preventDefault(); }
          } else if (e.key === 'ArrowDown') {
            if (hi < hist.length - 1) { hi++; inp.value = hist[hi] || ''; }
            else { hi = hist.length; inp.value = ''; }
          }
        });
        wrap.addEventListener('click', () => inp.focus());
      }

      /* ── sync lab: offline queue → API ─────── */
      const sv = document.getElementById('syncv');
      if (sv) {
        const ctx = sv.getContext('2d');
        const font = s => s + 'px "Press Start 2P", monospace';
        const rnd = (a, b) => a + Math.random() * (b - a);
        let W = 320, H = 180;

        const resize = () => {
          const rect = sv.getBoundingClientRect();
          const w = Math.max(280, Math.min(Math.round(rect.width) || 320, 640));
          const h = Math.round(Math.min(240, Math.max(170, w * 0.52)));
          const dpr = Math.min(2, window.devicePixelRatio || 1);
          sv.width = Math.round(w * dpr);
          sv.height = Math.round(h * dpr);
          sv.style.height = h + 'px';
          W = w; H = h;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.imageSmoothingEnabled = false;
        };
        resize();
        window.addEventListener('resize', resize);

        const logEl = document.getElementById('syncLog');
        const log = (txt, cls) => {
          if (!logEl) return;
          const d = document.createElement('div');
          d.className = 'log-line' + (cls ? ' ' + cls : '');
          d.textContent = txt;
          logEl.prepend(d);
          while (logEl.children.length > 3) logEl.removeChild(logEl.lastChild);
        };

        let queue = [], synced = 0, flight = null, net = true, nextId = 1, last = 0, autoT = 1.8;

        const enqueue = manual => {
          const id = nextId++;
          queue.push(id);
          if (manual) sfx.key();
          log('+ order #' + String(id).padStart(2, '0') + ' queued on device', 'q');
        };

        const update = dt => {
          autoT -= dt;
          if (autoT <= 0) { enqueue(false); autoT = rnd(2.4, 4.4); }
          if (net && !flight && queue.length) {
            flight = { id: queue.shift(), t: 0 };
          }
          if (flight) {
            flight.t += dt;
            if (flight.t >= .7) {
              synced++;
              sfx.coin();
              log('✓ order #' + String(flight.id).padStart(2, '0') + ' synced to server', 's');
              flight = null;
            }
          }
        };

        const draw = ts => {
          const pad = 12;
          const boxW = Math.max(64, Math.min(104, W * 0.2));
          const boxH = Math.max(66, Math.round(H * 0.5));
          const boxTop = H - boxH - pad;
          const devX = pad, srvX = W - pad - boxW;
          const midY = boxTop + boxH / 2;

          /* bg + grid */
          ctx.fillStyle = '#04283E';
          ctx.fillRect(0, 0, W, H);
          ctx.fillStyle = 'rgba(0, 231, 255, .05)';
          for (let x = 0; x < W; x += 14) ctx.fillRect(x, 0, 1, H);
          for (let y = 0; y < H; y += 14) ctx.fillRect(0, y, W, 1);

          /* connection tube: dashes flow when online, break when offline */
          ctx.save();
          ctx.strokeStyle = net ? 'rgba(57, 255, 20, .65)' : 'rgba(255, 79, 163, .75)';
          ctx.lineWidth = 2;
          ctx.setLineDash(net ? [7, 7] : [2, 9]);
          ctx.lineDashOffset = net ? -(ts / 40) % 14 : (ts / 30) % 11;
          ctx.beginPath();
          ctx.moveTo(devX + boxW + 6, midY);
          ctx.lineTo(srvX - 6, midY);
          ctx.stroke();
          ctx.restore();

          /* device box (queue lives here) */
          const cell = Math.max(8, Math.min(12, Math.floor((boxW - 20) / 3) - 4));
          ctx.fillStyle = '#0B3A55';
          ctx.fillRect(devX, boxTop, boxW, boxH);
          ctx.strokeStyle = '#00E7FF';
          ctx.strokeRect(devX + .5, boxTop + .5, boxW - 1, boxH - 1);
          ctx.fillStyle = '#7DF3FF';
          ctx.font = font(7);
          ctx.fillText('DEVICE' + (queue.length > 9 ? ' +' + (queue.length - 9) : ''), devX + 2, boxTop - 8);
          ctx.font = font(5);
          ctx.fillStyle = 'rgba(125, 243, 255, .55)';
          ctx.fillText('OFFLINE QUEUE', devX + 3, boxTop + 12);

          const show = queue.slice(0, 9);
          for (let i = 0; i < show.length; i++) {
            const col = i % 3, row = Math.floor(i / 3);
            const x = devX + 8 + col * (cell + 4);
            const y = boxTop + boxH - 10 - (row + 1) * (cell + 4);
            ctx.fillStyle = '#FFD447';
            ctx.fillRect(x, y, cell, cell);
            ctx.fillStyle = 'rgba(4, 40, 62, .85)';
            ctx.fillRect(x + 2, y + 2, cell - 4, cell - 4);
          }

          /* server box */
          ctx.fillStyle = '#0B3A55';
          ctx.fillRect(srvX, boxTop, boxW, boxH);
          ctx.strokeStyle = '#00E7FF';
          ctx.strokeRect(srvX + .5, boxTop + .5, boxW - 1, boxH - 1);
          ctx.fillStyle = '#7DF3FF';
          ctx.font = font(7);
          ctx.fillText('SERVER' + (synced > 12 ? ' +' + (synced - 12) : ''), srvX + 2, boxTop - 8);
          ctx.font = font(5);
          ctx.fillStyle = 'rgba(125, 243, 255, .55)';
          ctx.fillText('SYNCED API', srvX + 3, boxTop + 12);
          for (let i = 0; i < Math.min(synced, 12); i++) {
            const col = i % 3, row = Math.floor(i / 3);
            const x = srvX + 8 + col * (cell + 4);
            const y = boxTop + boxH - 10 - (row + 1) * (cell + 4);
            ctx.fillStyle = '#39FF14';
            ctx.fillRect(x, y, cell, cell);
            ctx.fillStyle = 'rgba(4, 40, 62, .85)';
            ctx.fillRect(x + 2, y + 2, cell - 4, cell - 4);
          }

          /* flight packet with trail */
          if (flight) {
            const p = Math.min(1, flight.t / .7);
            const x = devX + boxW + 6 + (srvX - 6 - devX - boxW - 6) * p;
            ctx.fillStyle = 'rgba(255, 212, 71, .35)';
            ctx.fillRect(x - 14, midY - 2, 5, 4);
            ctx.fillRect(x - 22, midY - 1, 5, 2);
            ctx.fillStyle = '#FFD447';
            ctx.fillRect(x - 4, midY - 4, 9, 9);
            ctx.fillStyle = '#04283E';
            ctx.fillRect(x - 2, midY - 2, 5, 5);
          }

          /* network LED + label */
          ctx.fillStyle = net ? '#39FF14' : '#FF4FA3';
          ctx.beginPath();
          ctx.arc(W / 2 - 38, 15, 4, 0, Math.PI * 2);
          ctx.fill();
          ctx.font = font(6);
          ctx.fillStyle = '#BDEFFF';
          ctx.fillText(net ? 'NET: ONLINE' : 'NET: OFFLINE', W / 2 - 28, 18);

          /* counters */
          ctx.font = font(6);
          ctx.fillStyle = '#FFD447';
          ctx.fillText('QUEUE ' + queue.length, 8, 12);
          ctx.textAlign = 'right';
          ctx.fillStyle = '#39FF14';
          ctx.fillText('SYNCED ' + synced, W - 8, 12);
          ctx.textAlign = 'left';

          /* hint */
          if (!queue.length && !synced && !flight) {
            ctx.textAlign = 'center';
            ctx.fillStyle = '#7FB8D8';
            ctx.fillText('PRESS + NEW ORDER', W / 2, H / 2 - 24);
            ctx.textAlign = 'left';
          }
        };

        const loop = ts => {
          const dt = Math.min(.05, (ts - last) / 1000 || 0);
          last = ts;
          update(dt);
          draw(ts);
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);

        log('LAB READY — press + NEW ORDER, then cut the network', 'on');

        const no = document.getElementById('newOrder');
        if (no) no.addEventListener('click', () => enqueue(true));
        const nb = document.getElementById('netBtn');
        if (nb) nb.addEventListener('click', () => {
          net = !net;
          nb.textContent = net ? 'NET: ON' : 'NET: OFF';
          nb.classList.toggle('danger', !net);
          log(net
            ? '↻ network online — draining queue…'
            : '⚠ network offline — orders keep queueing', net ? 'on' : 'off');
          sfx.enter();
        });
      }

      /* ── night mode ─────────────────────────── */
      const themeBtn = document.getElementById('themeToggle');
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      let theme = 'light';
      try {
        theme = localStorage.getItem('hr_theme') ||
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (e) {}
      const applyTheme = () => {
        document.documentElement.setAttribute('data-theme', theme);
        if (themeMeta) themeMeta.setAttribute('content', theme === 'dark' ? '#0B1826' : '#45B5E8');
        if (themeBtn) {
          themeBtn.setAttribute('aria-pressed', String(theme === 'dark'));
          themeBtn.setAttribute('aria-label', theme === 'dark' ? 'Switch to day mode' : 'Switch to night mode');
          themeBtn.title = theme === 'dark' ? 'Switch to day mode' : 'Switch to night mode';
        }
      };
      applyTheme();
      if (themeBtn) themeBtn.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('hr_theme', theme); } catch (e) {}
        applyTheme();
      });

      /* ── github uplink (live API) ───────────── */
      (async () => {
        const GH = 'Poseidon9991';
        const tiles = document.getElementById('ghTiles');
        const langsEl = document.getElementById('ghLangs');
        const heatEl = document.getElementById('ghHeat');
        const foot = document.getElementById('ghFoot');
        if (!tiles && !langsEl && !heatEl) return;
        const fail = () => {
          if (tiles) [...tiles.querySelectorAll('.gh-tile')].forEach(tile => {
            const b = tile.querySelector('b');
            if (b) b.textContent = 'N/A';
            tile.classList.add('on');
          });
          if (foot) foot.innerHTML = '<a href="https://github.com/' + GH + '" rel="me noopener">◆ SIGNAL LOST — VIEW PROFILE ON GITHUB</a>';
        };
        try {
          const [uRes, rRes] = await Promise.all([
            fetch('https://api.github.com/users/' + GH),
            fetch('https://api.github.com/users/' + GH + '/repos?per_page=100&sort=updated')
          ]);
          if (!uRes.ok || !rRes.ok) return fail();
          const user = await uRes.json();
          const repos = await rRes.json();

          if (tiles) {
            const stars = repos.reduce((s, r) => s + (r.stargazers_count || 0), 0);
            const vals = [user.public_repos, stars, user.followers];
            [...tiles.querySelectorAll('.gh-tile')].forEach((tile, i) => {
              const b = tile.querySelector('b');
              if (b && vals[i] != null) b.textContent = String(vals[i]);
              tile.classList.add('on');
            });
          }

          if (langsEl) {
            const langs = {};
            repos.forEach(r => {
              if (r.fork || !r.language) return;
              langs[r.language] = (langs[r.language] || 0) + (r.size || 0);
            });
            const top = Object.entries(langs).sort((a, b) => b[1] - a[1]).slice(0, 5);
            const max = top.length ? top[0][1] : 1;
            const total = top.reduce((s, l) => s + l[1], 0) || 1;
            langsEl.innerHTML = top.map(([name, size]) =>
              '<div class="lrow"><span class="lname">' + name + '</span>' +
              '<span class="ltrack"><i class="lbar" style="width:' + Math.round(size / max * 100) + '%"></i></span>' +
              '<b class="lpct">' + Math.round(size / total * 100) + '%</b></div>'
            ).join('');
          }

          if (heatEl) {
            const counts = {};
            for (let p = 1; p <= 3; p++) {
              const res = await fetch('https://api.github.com/users/' + GH + '/events/public?per_page=100&page=' + p);
              if (!res.ok) break;
              const evs = await res.json();
              if (!Array.isArray(evs) || !evs.length) break;
              evs.forEach(e => {
                const d = (e.created_at || '').slice(0, 10);
                if (d) counts[d] = (counts[d] || 0) + 1;
              });
            }
            const today = new Date();
            let total = 0;
            for (let i = 90; i >= 0; i--) {
              const d = new Date(today);
              d.setDate(d.getDate() - i);
              const key = d.toISOString().slice(0, 10);
              const c = counts[key] || 0;
              total += c;
              const cell = document.createElement('i');
              cell.dataset.l = c === 0 ? 0 : c === 1 ? 1 : c <= 3 ? 2 : c <= 6 ? 3 : 4;
              cell.title = c + (c === 1 ? ' event' : ' events') + ' · ' + key;
              cell.style.animationDelay = ((90 - i) * 6) + 'ms';
              heatEl.appendChild(cell);
            }
            heatEl.setAttribute('aria-label', 'GitHub public activity, last 90 days — ' + total + ' events');
          }
        } catch (e) { fail(); }
      })();

      /* ── boot screen (PLAYER 1 — PRESS START) ─ */
      const boot = document.getElementById('boot');
      let booted = false, experienceStarted = false;
      const startExperience = () => {
        if (experienceStarted) return;
        experienceStarted = true;
        document.querySelectorAll('.reveal').forEach(el => io.observe(el));
        shellBootStart();
      };
      if (boot) {
        document.body.classList.add('booting');
        const bootLog = document.getElementById('bootLog');
        const lines = [
          'CHECKING MEMORY ......... <b class="ok">OK</b>',
          'LOADING SKILL TREE ...... <b class="ok">OK</b>',
          'LOADING QUEST LOG ....... <b class="ok">OK</b>',
          'SYNC LAB CALIBRATION .... <b class="ok">OK</b>',
          'GITHUB UPLINK ........... <b class="ok">OK</b>',
          'PLAYER 1 ............ <b class="ok">READY</b>',
        ];
        const finishBoot = () => {
          if (booted) return;
          booted = true;
          sfx.start();
          document.body.classList.remove('booting');
          boot.classList.add('done');
          setTimeout(() => boot.remove(), 550);
          startExperience();
        };
        boot.addEventListener('click', finishBoot);
        document.addEventListener('keydown', e => {
          if (booted) return;
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); finishBoot(); }
        });
        (async () => {
          const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
          for (const l of lines) {
            const d = document.createElement('div');
            d.innerHTML = l;
            if (bootLog) bootLog.appendChild(d);
            if (!reduced) await new Promise(r => setTimeout(r, 150));
          }
          boot.classList.add('ready');
        })();
      } else {
        startExperience();
      }
    })();
  </script>
</body>
</html>
